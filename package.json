{
  "name": "ui-kit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --dir apps/theme-designer build",
    "build:registry": "tsx scripts/build-registry.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "serve:registry": "node scripts/serve-registry.mjs",
    "check:themes": "node scripts/check-theme-tokens.mjs",
    "check:parity": "node scripts/audit-react-parity.mjs",
    "check:demos": "node scripts/check-demo-render.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}