{
  "name": "x-modal",
  "type": "registry:ui",
  "title": "对话框",
  "description": "模态对话框，默认提供取消与确定按钮。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/dialog",
    "@ui-kit/x-button"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\n/**\n * XModal 对话框：与 Nuxt UI Modal 对齐的模态对话框。\n * 属性、插槽与 ui 主题插槽键（overlay / content / header / wrapper / body / footer / title / description / close）一比一对应。\n * 支持 scrollable 滚动遮罩、fullscreen 全屏、close 关闭按钮、dismissible 关闭策略。\n */\nimport type { Component, HTMLAttributes } from 'vue'\nimport { computed, useSlots } from 'vue'\nimport { createReusableTemplate } from '@vueuse/core'\nimport { XIcon } from '@lucide/vue'\nimport {\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogOverlay,\n  DialogPortal,\n  DialogRoot,\n  DialogTitle,\n  DialogTrigger,\n  VisuallyHidden,\n} from 'reka-ui'\nimport XButton from '@/components/kit/XButton.vue'\nimport { cn } from '@/lib/utils'\n\n/** close 为对象时透传给关闭按钮的属性 */\nexport type ModalClose = boolean | {\n  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl'\n  color?: 'primary' | 'secondary' | 'neutral' | 'success' | 'info' | 'warning' | 'error'\n  variant?: 'solid' | 'outline' | 'soft' | 'ghost' | 'subtle' | 'link'\n}\n\n/** 主题插槽类名，键名与 Nuxt UI 主题保持一致 */\nexport interface ModalUi {\n  overlay?: string\n  content?: string\n  header?: string\n  wrapper?: string\n  body?: string\n  footer?: string\n  title?: string\n  description?: string\n  close?: string\n}\n\nconst props = withDefaults(defineProps<{\n  /** 标题 */\n  title?: string\n  /** 辅助说明 */\n  description?: string\n  /** 是否打开（支持 v-model:open） */\n  open?: boolean\n  /** 初始是否打开 */\n  defaultOpen?: boolean\n  /** 模态：聚焦锁定与遮罩拦截 */\n  modal?: boolean\n  /** 关闭后卸载内容 */\n  unmountOnHide?: boolean\n  /** 渲染遮罩 */\n  overlay?: boolean\n  /** 滚动遮罩模式：内容随遮罩滚动居中 */\n  scrollable?: boolean\n  /** 开关动画 */\n  transition?: boolean\n  /** 全屏模式 */\n  fullscreen?: boolean\n  /** 渲染到 body */\n  portal?: boolean\n  /** 显示关闭按钮 */\n  close?: ModalClose\n  /** 关闭按钮图标 */\n  closeIcon?: Component\n  /** 允许点击外部或按 Esc 关闭 */\n  dismissible?: boolean\n  class?: HTMLAttributes['class']\n  /** 主题插槽类名 */\n  ui?: ModalUi\n}>(), {\n  modal: true,\n  overlay: true,\n  scrollable: false,\n  transition: true,\n  fullscreen: false,\n  portal: true,\n  close: true,\n  dismissible: true,\n})\n\nconst emit = defineEmits<{\n  /** 打开状态变化回调 */\n  'update:open': [open: boolean]\n  /** 关闭被阻止（dismissible 为 false 时点击外部或按 Esc） */\n  'close:prevent': []\n}>()\n\ndefineOptions({ name: 'XModal', inheritAttrs: false })\n\nconst slots = useSlots()\n\n/** dismissible 为 false 时阻止外部点击与 Esc 关闭 */\nconst contentEvents = computed(() => {\n  if (props.dismissible) return {}\n  return {\n    interactOutside: (event: Event) => {\n      event.preventDefault()\n      emit('close:prevent')\n    },\n    escapeKeyDown: (event: Event) => {\n      event.preventDefault()\n      emit('close:prevent')\n    },\n  }\n})\n\nconst showHeader = computed(\n  () =>\n    !!slots.header ||\n    props.title != null ||\n    !!slots.title ||\n    props.description != null ||\n    !!slots.description ||\n    Boolean(props.close) ||\n    !!slots.close,\n)\n\nconst showWrapper = computed(\n  () => props.title != null || !!slots.title || props.description != null || !!slots.description,\n)\n\n/** 内容面板与遮罩在 scrollable 两种模式下的复用模板 */\nconst [DefineModalContent, ReuseModalContent] = createReusableTemplate()\n</script>\n\n<template>\n  <DialogRoot\n    :open=\"props.open\"\n    :default-open=\"props.defaultOpen\"\n    :modal=\"props.modal\"\n    :unmount-on-hide=\"props.unmountOnHide\"\n    @update:open=\"(next: boolean) => emit('update:open', next)\"\n  >\n    <DialogTrigger v-if=\"slots.default\" as-child :class=\"props.class\" v-bind=\"$attrs\">\n      <slot />\n    </DialogTrigger>\n\n    <DialogPortal :disabled=\"!props.portal\">\n      <DefineModalContent>\n        <DialogContent\n          data-slot=\"content\"\n          :class=\"cn(\n            'bg-background divide-y divide-border flex flex-col focus:outline-none z-50',\n            props.transition && 'data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95',\n            props.fullscreen ? 'inset-0' : 'w-[calc(100vw-2rem)] max-w-lg rounded-lg shadow-lg ring-1 ring-border',\n            props.scrollable ? 'relative' : props.fullscreen ? 'fixed' : 'fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 max-h-[calc(100dvh-2rem)] sm:max-h-[calc(100dvh-4rem)] overflow-hidden origin-center',\n            !slots.default && props.class,\n            props.ui?.content,\n          )\"\n          v-on=\"contentEvents\"\n        >\n          <VisuallyHidden\n            v-if=\"(props.title == null && !slots.title) || (props.description == null && !slots.description) || !!slots.content || !!slots.header\"\n          >\n            <DialogTitle v-if=\"props.title == null && !slots.title\" />\n            <DialogTitle v-else>\n              <slot name=\"title\">{{ props.title }}</slot>\n            </DialogTitle>\n\n            <DialogDescription v-if=\"props.description == null && !slots.description\" />\n            <DialogDescription v-else>\n              <slot name=\"description\">{{ props.description }}</slot>\n            </DialogDescription>\n          </VisuallyHidden>\n\n          <slot name=\"content\">\n            <div\n              v-if=\"showHeader\"\n              data-slot=\"header\"\n              :class=\"cn('flex items-center gap-1.5 p-4 sm:px-6', props.ui?.header)\"\n            >\n              <slot name=\"header\">\n                <div v-if=\"showWrapper\" data-slot=\"wrapper\" :class=\"cn('min-w-0 flex-1', props.ui?.wrapper)\">\n                  <DialogTitle\n                    v-if=\"props.title != null || !!slots.title\"\n                    data-slot=\"title\"\n                    :class=\"cn('text-foreground font-semibold', props.ui?.title)\"\n                  >\n                    <slot name=\"title\">{{ props.title }}</slot>\n                  </DialogTitle>\n\n                  <DialogDescription\n                    v-if=\"props.description != null || !!slots.description\"\n                    data-slot=\"description\"\n                    :class=\"cn('mt-1 text-muted-foreground text-sm', props.ui?.description)\"\n                  >\n                    <slot name=\"description\">{{ props.description }}</slot>\n                  </DialogDescription>\n                </div>\n\n                <slot name=\"actions\" />\n\n                <DialogClose v-if=\"Boolean(props.close) || !!slots.close\" as-child>\n                  <slot name=\"close\">\n                    <XButton\n                      v-if=\"props.close\"\n                      data-slot=\"close\"\n                      color=\"neutral\"\n                      variant=\"ghost\"\n                      square\n                      aria-label=\"关闭\"\n                      v-bind=\"typeof props.close === 'object' ? props.close : {}\"\n                      :class=\"cn('absolute top-4 right-4', props.ui?.close)\"\n                    >\n                      <component :is=\"props.closeIcon ?? XIcon\" class=\"size-4\" />\n                    </XButton>\n                  </slot>\n                </DialogClose>\n              </slot>\n            </div>\n\n            <div v-if=\"!!slots.body\" data-slot=\"body\" :class=\"cn('flex-1 p-4 sm:p-6', !props.scrollable && 'overflow-y-auto', props.ui?.body)\">\n              <slot name=\"body\" />\n            </div>\n\n            <div v-if=\"!!slots.footer\" data-slot=\"footer\" :class=\"cn('flex items-center gap-1.5 p-4 sm:px-6', props.ui?.footer)\">\n              <slot name=\"footer\" />\n            </div>\n          </slot>\n        </DialogContent>\n      </DefineModalContent>\n\n      <template v-if=\"props.scrollable\">\n        <DialogOverlay\n          data-slot=\"overlay\"\n          :class=\"cn(\n            'fixed inset-0 z-50',\n            props.overlay && 'bg-black/50',\n            props.transition && 'data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0',\n            'overflow-y-auto grid place-items-center p-4 sm:py-8',\n            props.ui?.overlay,\n          )\"\n        >\n          <ReuseModalContent />\n        </DialogOverlay>\n      </template>\n\n      <template v-else>\n        <DialogOverlay\n          v-if=\"props.overlay\"\n          data-slot=\"overlay\"\n          :class=\"cn(\n            'fixed inset-0 z-50 bg-black/50',\n            props.transition && 'data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=closed]:fade-out-0',\n            props.ui?.overlay,\n          )\"\n        />\n\n        <ReuseModalContent />\n      </template>\n    </DialogPortal>\n  </DialogRoot>\n</template>\n",
      "path": "kit/XModal.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * useXModal：创建与 api 绑定的对话框。\n * 用法：const [Modal, modalApi] = useXModal({ title: '...' })\n */\nimport { defineComponent, h, reactive, ref } from 'vue'\nimport XModal from './XModal.vue'\n\n/** 可由 api 管理的对话框状态 */\nexport interface XModalState {\n  title?: string\n  description?: string\n  fullscreen?: boolean\n}\n\nexport interface XModalApi {\n  /** 打开对话框 */\n  open: () => void\n  /** 关闭对话框 */\n  close: () => void\n  /** 切换开合 */\n  toggle: () => void\n  /** 更新内部状态（标题、说明、全屏等） */\n  setState: (patch: XModalState) => void\n  /** 写入共享数据，供对话框内容读取 */\n  setData: <T extends object = Record<string, unknown>>(payload: T) => void\n  /** 读取共享数据 */\n  getData: <T extends object = Record<string, unknown>>() => T\n}\n\nexport function useXModal(options: XModalState & { defaultOpen?: boolean } = {}) {\n  const state = reactive({\n    open: options.defaultOpen ?? false,\n    title: options.title,\n    description: options.description,\n    fullscreen: options.fullscreen,\n  })\n\n  /** 与对话框共享的数据载荷 */\n  const payload = ref<Record<string, unknown>>({})\n\n  const Modal = defineComponent({\n    name: 'XModalBound',\n    setup(_, { attrs, slots }) {\n      return () =>\n        h(\n          XModal,\n          {\n            ...attrs,\n            open: state.open,\n            title: state.title ?? (attrs.title as string | undefined),\n            description: state.description ?? (attrs.description as string | undefined),\n            fullscreen: state.fullscreen ?? (attrs.fullscreen as boolean | undefined),\n            'onUpdate:open': (open: boolean) => {\n              state.open = open\n            },\n          } as never,\n          slots as never,\n        )\n    },\n  })\n\n  const api: XModalApi = {\n    open: () => {\n      state.open = true\n    },\n    close: () => {\n      state.open = false\n    },\n    toggle: () => {\n      state.open = !state.open\n    },\n    setState: (patch) => Object.assign(state, patch),\n    setData: <T extends object = Record<string, unknown>>(data: T) => {\n      payload.value = data as Record<string, unknown>\n    },\n    getData: <T extends object = Record<string, unknown>>() => payload.value as T,\n  }\n\n  return [Modal, api] as const\n}\n",
      "path": "kit/useXModal.ts"
    }
  ],
