{
  "name": "x-carousel",
  "type": "registry:ui",
  "title": "轮播",
  "description": "多张内容横向轮播展示，支持自动播放与循环。",
  "dependencies": [
    "embla-carousel-autoplay",
    "embla-carousel-vue",
    "@lucide/vue",
    "reka-ui"
  ],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/carousel",
    "@ui-kit/x-button"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<!-- eslint-disable vue/block-tag-newline -->\n<script lang=\"ts\">\nimport type { VNode } from 'vue'\nimport type { AppConfig } from '@/lib/nuxt/types/app-config'\nimport type { EmblaCarouselType, EmblaOptionsType, EmblaPluginType } from 'embla-carousel'\nimport type { AutoplayOptionsType } from 'embla-carousel-autoplay'\nimport type { AutoScrollOptionsType } from 'embla-carousel-auto-scroll'\nimport type { AutoHeightOptionsType } from 'embla-carousel-auto-height'\nimport type { ClassNamesOptionsType } from 'embla-carousel-class-names'\nimport type { FadeOptionsType } from 'embla-carousel-fade'\nimport type { WheelGesturesPluginOptions } from 'embla-carousel-wheel-gestures'\nimport theme from '@/lib/nuxt/ui/carousel'\nimport type { ButtonProps } from './XButton.vue'\nimport type { IconProps } from './XIcon.vue'\nimport type { LinkPropsKeys } from './XLink.vue'\nimport type { AcceptableValue } from '../../lib/nuxt/types/utils'\nimport type { ComponentConfig } from '../../lib/nuxt/types/tv'\n\ntype Carousel = ComponentConfig<typeof theme, AppConfig, 'carousel'>\n\nexport type CarouselValue = AcceptableValue\nexport type CarouselItem = CarouselValue | {\n  class?: any\n  ui?: Partial<Pick<Carousel['slots'], 'item'>>\n  [key: string]: any\n}\n\nexport interface CarouselProps<T extends CarouselItem = CarouselItem> {\n\n  /**\n   * The element or component this component should render as.\n   * @defaultValue 'div'\n   */\n  as?: any\n  /**\n   * Configure the prev button when arrows are enabled.\n   * @defaultValue { size: 'md', color: 'neutral', variant: 'link' }\n   */\n  prev?: Omit<ButtonProps, LinkPropsKeys>\n  /**\n   * The icon displayed in the prev button.\n   * @defaultValue appConfig.ui.icons.arrowLeft\n   * @IconifyIcon\n   */\n  prevIcon?: IconProps['name']\n  /**\n   * Configure the next button when arrows are enabled.\n   * @defaultValue { size: 'md', color: 'neutral', variant: 'link' }\n   */\n  next?: Omit<ButtonProps, LinkPropsKeys>\n  /**\n   * The icon displayed in the next button.\n   * @defaultValue appConfig.ui.icons.arrowRight\n   * @IconifyIcon\n   */\n  nextIcon?: IconProps['name']\n  /**\n   * Display prev and next buttons to scroll the carousel.\n   * @defaultValue false\n   */\n  arrows?: boolean\n  /**\n   * Display dots to scroll to a specific slide.\n   * @defaultValue false\n   */\n  dots?: boolean\n  /**\n   * The orientation of the carousel.\n   * @defaultValue 'horizontal'\n   */\n  orientation?: Carousel['variants']['orientation']\n  items?: T[]\n  /**\n   * Enable Autoplay plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/autoplay\n   */\n  autoplay?: boolean | AutoplayOptionsType\n  /**\n   * Enable Auto Scroll plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/auto-scroll\n   */\n  autoScroll?: boolean | AutoScrollOptionsType\n  /**\n   * Enable Auto Height plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/auto-height\n   */\n  autoHeight?: boolean | AutoHeightOptionsType\n  /**\n   * Enable Class Names plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/class-names\n   */\n  classNames?: boolean | ClassNamesOptionsType\n  /**\n   * Enable Fade plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/fade\n   */\n  fade?: boolean | FadeOptionsType\n  /**\n   * Enable Wheel Gestures plugin\n   * @see https://www.embla-carousel.com/docs/v8/plugins/wheel-gestures\n   */\n  wheelGestures?: boolean | WheelGesturesPluginOptions\n  class?: any\n  ui?: Carousel['slots']\n}\n\nexport type CarouselSlots<T extends CarouselItem = CarouselItem> = {\n  default?(props: { item: T, index: number }): VNode[]\n}\n\nexport interface CarouselEmits {\n  /**\n   * Emitted when the selected slide changes\n   * @param selectedIndex The index of the selected slide\n   */\n  select: [selectedIndex: number]\n}\n</script>\n\n<script setup lang=\"ts\" generic=\"T extends CarouselItem\">\nimport { computed, ref, watch, onMounted, onBeforeUnmount } from 'vue'\nimport useEmblaCarousel from 'embla-carousel-vue'\nimport { Primitive } from 'reka-ui'\nimport { reactivePick } from '@vueuse/core'\nimport { useAppConfig } from '@/lib/nuxt/imports'\nimport { useComponentProps } from '../../lib/nuxt/composables/useComponentProps'\nimport { useForwardProps } from '../../lib/nuxt/composables/useForwardProps'\nimport { useLocale } from '../../lib/nuxt/composables/useLocale'\nimport { tv } from '../../lib/nuxt/utils/tv'\nimport XButton from './XButton.vue'\n\nconst _props = withDefaults(defineProps<CarouselProps<T>>(), {\n  orientation: 'horizontal',\n  arrows: false,\n  dots: false,\n  // Embla Options\n  active: true,\n  align: 'center',\n  breakpoints: () => ({}),\n  containScroll: 'trimSnaps',\n  dragFree: false,\n  dragThreshold: 10,\n  duration: 25,\n  inViewThreshold: 0,\n  loop: false,\n  skipSnaps: false,\n  slidesToScroll: 1,\n  startIndex: 0,\n  watchDrag: true,\n  watchResize: true,\n  watchSlides: true,\n  watchFocus: true,\n  // Embla Plugins\n  autoplay: false,\n  autoScroll: false,\n  autoHeight: false,\n  classNames: false,\n  fade: false,\n  wheelGestures: false\n})\ndefineSlots<CarouselSlots<T>>()\nconst emits = defineEmits<CarouselEmits>()\n\nconst props = useComponentProps<CarouselProps<T>>('carousel', _props)\n\nconst { dir, t } = useLocale()\nconst appConfig = useAppConfig() as Carousel['AppConfig']\n\nconst rootProps = useForwardProps(reactivePick(props, 'active', 'align', 'breakpoints', 'containScroll', 'dragFree', 'dragThreshold', 'duration', 'inViewThreshold', 'loop', 'skipSnaps', 'slidesToScroll', 'startIndex', 'watchDrag', 'watchResize', 'watchSlides', 'watchFocus'))\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst prevIcon = computed(() => props.prevIcon || (dir.value === 'rtl' ? appConfig.ui.icons.arrowRight : appConfig.ui.icons.arrowLeft))\n// eslint-disable-next-line vue/no-dupe-keys\nconst nextIcon = computed(() => props.nextIcon || (dir.value === 'rtl' ? appConfig.ui.icons.arrowLeft : appConfig.ui.icons.arrowRight))\n\nconst stopAutoplayOnInteraction = computed(() => {\n  if (typeof props.autoplay === 'boolean') {\n    return true\n  }\n\n  return props.autoplay?.stopOnInteraction ?? true\n})\n\nconst stopAutoScrollOnInteraction = computed(() => {\n  if (typeof props.autoScroll === 'boolean') {\n    return true\n  }\n\n  return props.autoScroll?.stopOnInteraction ?? true\n})\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst ui = computed(() => tv({ extend: theme, ...(appConfig.ui?.carousel || {}) })({\n  orientation: props.orientation\n}))\n\nconst options = computed<EmblaOptionsType>(() => ({\n  ...(props.fade ? { align: 'center', containScroll: false } : {}),\n  ...rootProps.value,\n  axis: props.orientation === 'horizontal' ? 'x' : 'y',\n  direction: dir.value === 'rtl' ? 'rtl' : 'ltr'\n}))\n\nconst plugins = ref<EmblaPluginType[]>([])\n\nasync function loadPlugins() {\n  const emblaPlugins: EmblaPluginType[] = []\n\n  if (props.autoplay) {\n    const AutoplayPlugin = await import('embla-carousel-autoplay').then(r => r.default)\n    emblaPlugins.push(AutoplayPlugin(typeof props.autoplay === 'boolean' ? {} : props.autoplay))\n  }\n\n  if (props.autoScroll) {\n    const AutoScrollPlugin = await import('embla-carousel-auto-scroll').then(r => r.default)\n    emblaPlugins.push(AutoScrollPlugin(typeof props.autoScroll === 'boolean' ? {} : props.autoScroll))\n  }\n\n  if (props.autoHeight) {\n    const AutoHeightPlugin = await import('embla-carousel-auto-height').then(r => r.default)\n    emblaPlugins.push(AutoHeightPlugin(typeof props.autoHeight === 'boolean' ? {} : props.autoHeight))\n  }\n\n  if (props.classNames) {\n    const ClassNamesPlugin = await import('embla-carousel-class-names').then(r => r.default)\n    emblaPlugins.push(ClassNamesPlugin(typeof props.classNames === 'boolean' ? {} : props.classNames))\n  }\n\n  if (props.fade) {\n    const FadePlugin = await import('embla-carousel-fade').then(r => r.default)\n    emblaPlugins.push(FadePlugin(typeof props.fade === 'boolean' ? {} : props.fade))\n  }\n\n  if (props.wheelGestures) {\n    const { WheelGesturesPlugin } = await import('embla-carousel-wheel-gestures')\n    emblaPlugins.push(WheelGesturesPlugin(typeof props.wheelGestures === 'boolean' ? {} : props.wheelGestures))\n  }\n\n  plugins.value = emblaPlugins\n}\n\n// Rebuild the plugins array whenever a plugin prop changes. `useEmblaCarousel`\n// watches the `plugins` ref and reinitializes through its own `arePluginsEqual`\n// guard, so we must not reinitialize here: plugin props passed as inline objects\n// (e.g. `:autoplay=\"{ delay: 5000 }\"`) get a new reference on every parent render,\n// which would otherwise reinitialize the carousel and reset it to the first slide.\nwatch(() => [props.autoplay, props.autoScroll, props.autoHeight, props.classNames, props.fade, props.wheelGestures], loadPlugins, { immediate: true })\n\nconst [emblaRef, emblaApi] = useEmblaCarousel(options, plugins)\n\nwatch(options, () => {\n  emblaApi.value?.reInit(options.value, plugins.value)\n}, { flush: 'post' })\n\nfunction stopOnInteraction() {\n  if (stopAutoplayOnInteraction.value) {\n    emblaApi.value?.plugins().autoplay?.stop()\n  }\n\n  if (stopAutoScrollOnInteraction.value) {\n    emblaApi.value?.plugins().autoScroll?.stop()\n  }\n}\n\nfunction scrollPrev() {\n  emblaApi.value?.scrollPrev()\n  stopOnInteraction()\n}\n\nfunction scrollNext() {\n  emblaApi.value?.scrollNext()\n  stopOnInteraction()\n}\n\nfunction scrollTo(index: number) {\n  emblaApi.value?.scrollTo(index)\n}\n\nfunction onKeyDown(event: KeyboardEvent) {\n  let prevKey\n  let nextKey\n  if (props.orientation === 'horizontal') {\n    prevKey = dir.value === 'ltr' ? 'ArrowLeft' : 'ArrowRight'\n    nextKey = dir.value === 'ltr' ? 'ArrowRight' : 'ArrowLeft'\n  } else {\n    prevKey = 'ArrowUp'\n    nextKey = 'ArrowDown'\n  }\n\n  if (event.key === prevKey) {\n    event.preventDefault()\n    scrollPrev()\n\n    return\n  }\n\n  if (event.key === nextKey) {\n    event.preventDefault()\n    scrollNext()\n  }\n}\n\nconst canScrollNext = ref(false)\nconst canScrollPrev = ref(false)\nconst selectedIndex = ref<number>(0)\nconst scrollSnaps = ref<number[]>([])\n\nfunction onInit(api: EmblaCarouselType) {\n  scrollSnaps.value = api?.scrollSnapList() || []\n}\n\nfunction onSelect(api: EmblaCarouselType) {\n  canScrollNext.value = api?.canScrollNext() || false\n  canScrollPrev.value = api?.canScrollPrev() || false\n  selectedIndex.value = api?.selectedScrollSnap() || 0\n\n  emits('select', selectedIndex.value)\n}\n\nfunction isCarouselItem(item: CarouselItem): item is Exclude<CarouselItem, CarouselValue> {\n  return typeof item === 'object' && item !== null\n}\n\nonMounted(() => {\n  if (!emblaApi.value) {\n    return\n  }\n\n  emblaApi.value.on('init', onInit)\n  emblaApi.value.on('init', onSelect)\n  emblaApi.value.on('reInit', onInit)\n  emblaApi.value.on('reInit', onSelect)\n  emblaApi.value.on('select', onSelect)\n})\n\nonBeforeUnmount(() => {\n  if (!emblaApi.value) {\n    return\n  }\n\n  emblaApi.value.off('init', onInit)\n  emblaApi.value.off('init', onSelect)\n  emblaApi.value.off('reInit', onInit)\n  emblaApi.value.off('reInit', onSelect)\n  emblaApi.value.off('select', onSelect)\n})\n\ndefineExpose({\n  emblaRef,\n  emblaApi\n})\n</script>\n\n<template>\n  <Primitive\n    :as=\"props.as\"\n    role=\"region\"\n    aria-roledescription=\"carousel\"\n    :data-orientation=\"props.orientation\"\n    tabindex=\"0\"\n    data-slot=\"root\"\n    :class=\"ui.root({ class: [props.ui?.root, props.class] })\"\n    @keydown=\"onKeyDown\"\n  >\n    <div ref=\"emblaRef\" data-slot=\"viewport\" :class=\"ui.viewport({ class: props.ui?.viewport })\">\n      <div data-slot=\"container\" :class=\"ui.container({ class: props.ui?.container })\">\n        <div\n          v-for=\"(item, index) in props.items\"\n          :key=\"index\"\n          v-bind=\"props.dots ? { role: 'tabpanel' } : { 'role': 'group', 'aria-roledescription': 'slide' }\"\n          data-slot=\"item\"\n          :class=\"ui.item({ class: [props.ui?.item, isCarouselItem(item) && item.ui?.item, isCarouselItem(item) && item.class] })\"\n        >\n          <slot :item=\"item\" :index=\"index\" />\n        </div>\n      </div>\n    </div>\n\n    <div v-if=\"props.arrows || props.dots\" data-slot=\"controls\" :class=\"ui.controls({ class: props.ui?.controls })\">\n      <div v-if=\"props.arrows\" data-slot=\"arrows\" :class=\"ui.arrows({ class: props.ui?.arrows })\">\n        <XButton\n          :disabled=\"!canScrollPrev\"\n          :icon=\"prevIcon\"\n          color=\"neutral\"\n          variant=\"outline\"\n          :aria-label=\"t('carousel.prev')\"\n          v-bind=\"typeof props.prev === 'object' ? props.prev : undefined\"\n          data-slot=\"prev\"\n          :class=\"ui.prev({ class: props.ui?.prev })\"\n          @click=\"scrollPrev\"\n        />\n        <XButton\n          :disabled=\"!canScrollNext\"\n          :icon=\"nextIcon\"\n          color=\"neutral\"\n          variant=\"outline\"\n          :aria-label=\"t('carousel.next')\"\n          v-bind=\"typeof props.next === 'object' ? props.next : undefined\"\n          data-slot=\"next\"\n          :class=\"ui.next({ class: props.ui?.next })\"\n          @click=\"scrollNext\"\n        />\n      </div>\n\n      <div v-if=\"props.dots\" role=\"tablist\" :aria-label=\"t('carousel.dots')\" data-slot=\"dots\" :class=\"ui.dots({ class: props.ui?.dots })\">\n        <template v-for=\"(_, index) in scrollSnaps\" :key=\"index\">\n          <button\n            type=\"button\"\n            role=\"tab\"\n            :aria-label=\"t('carousel.goto', { slide: index + 1 })\"\n            :aria-selected=\"selectedIndex === index\"\n            data-slot=\"dot\"\n            :class=\"ui.dot({ class: props.ui?.dot, active: selectedIndex === index })\"\n            :data-state=\"selectedIndex === index ? 'active' : undefined\"\n            @click=\"scrollTo(index)\"\n          />\n        </template>\n      </div>\n    </div>\n  </Primitive>\n</template>\n",
      "path": "kit/XCarousel.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * 基于 embla 内部引擎实现的连续滚动插件，对齐 Nuxt UI 的 autoScroll 行为。\n * 依赖 embla 的 internalEngine / scrollTo / rootNode / 事件接口。\n */\n\n/** autoScroll 配置：speed 越大滚动越快，direction 控制方向 */\nexport interface XCarouselAutoScrollOptions {\n  speed?: number\n  direction?: 'forward' | 'backward'\n  stopOnInteraction?: boolean\n  stopOnMouseEnter?: boolean\n  stopOnFocusIn?: boolean\n}\n\n/** embla api 的最小接口（与 embla-carousel 的 EmblaCarouselType 兼容） */\nexport interface XCarouselEmblaApi {\n  internalEngine: () => {\n    scrollBody: { location: { get: () => number } }\n  }\n  rootNode: () => HTMLElement\n  scrollTo: (target: number) => void\n  on: (event: string, callback: () => void) => void\n  off: (event: string, callback: () => void) => void\n}\n\n/**\n * 创建 autoScroll 插件：每帧按流逝时间推进滚动位置。\n * 插件协议对齐 embla 8.x：返回 { name, options, init, destroy } 对象。\n */\nexport function createAutoScrollPlugin(options: XCarouselAutoScrollOptions = {}) {\n  const {\n    speed = 1,\n    direction = 'forward',\n    stopOnInteraction = true,\n    stopOnMouseEnter = false,\n    stopOnFocusIn = true,\n  } = options\n\n  const factor = 0.05 * speed\n  const directionFactor = direction === 'backward' ? -1 : 1\n\n  let rafId = 0\n  let running = true\n  let lastTime = performance.now()\n  let root: HTMLElement\n  let emblaApi: XCarouselEmblaApi\n\n  const stop = () => {\n    running = false\n  }\n\n  const play = () => {\n    running = true\n    lastTime = performance.now()\n  }\n\n  const move = () => {\n    const now = performance.now()\n    const elapsed = now - lastTime\n    lastTime = now\n    if (running) {\n      const current = emblaApi.internalEngine().scrollBody.location.get()\n      emblaApi.scrollTo(current + directionFactor * elapsed * factor)\n    }\n    rafId = requestAnimationFrame(move)\n  }\n\n  function init(api: XCarouselEmblaApi) {\n    emblaApi = api\n    root = api.rootNode()\n    rafId = requestAnimationFrame(move)\n\n    if (stopOnInteraction) emblaApi.on('pointerDown', stop)\n    if (stopOnMouseEnter) {\n      root.addEventListener('mouseenter', stop)\n      root.addEventListener('mouseleave', play)\n    }\n    if (stopOnFocusIn) {\n      root.addEventListener('focusin', stop)\n      root.addEventListener('focusout', play)\n    }\n  }\n\n  function destroy() {\n    cancelAnimationFrame(rafId)\n    if (stopOnInteraction) emblaApi.off('pointerDown', stop)\n    root.removeEventListener('mouseenter', stop)\n    root.removeEventListener('mouseleave', play)\n    root.removeEventListener('focusin', stop)\n    root.removeEventListener('focusout', play)\n  }\n\n  return {\n    name: 'autoScroll',\n    options,\n    init,\n    destroy,\n    stop,\n    play,\n  }\n}\n",
      "path": "kit/auto-scroll-plugin.ts"
    },
    {
      "type": "registry:component",
      "content": "/**\n * 基于 embla 事件实现的类名插件，对齐 embla-carousel-class-names 的行为。\n * 五个类名钩子：loop 与 draggable 加在根节点，dragging 在拖拽期间加在根节点，\n * snapped 加在当前吸附的滑动项，inView 加在进入视口的滑动项。\n */\n\n/** classNames 配置：每个钩子接收一个或多个类名 */\nexport interface XCarouselClassNamesOptions {\n  /** 开启时给循环轮播的根节点加类名 */\n  loop?: string | string[]\n  /** 开启时给可拖拽轮播的根节点加类名 */\n  draggable?: string | string[]\n  /** 拖拽期间给根节点加类名 */\n  dragging?: string | string[]\n  /** 当前吸附的滑动项 */\n  snapped?: string | string[]\n  /** 进入视口的滑动项 */\n  inView?: string | string[]\n}\n\n/** embla api 的最小接口（与 embla-carousel 的 EmblaCarouselType 兼容） */\nexport interface XCarouselClassNamesApi {\n  rootNode: () => HTMLElement\n  slideNodes: () => HTMLElement[]\n  slidesInView: () => number[]\n  selectedScrollSnap: () => number\n  internalEngine: () => {\n    options: { loop: boolean; watchDrag: boolean | ((...args: unknown[]) => boolean) }\n    slideRegistry: number[][]\n  }\n  on: (event: string, callback: (...args: unknown[]) => void) => void\n  off: (event: string, callback: (...args: unknown[]) => void) => void\n}\n\n/** 统一成类名数组:支持空格分隔的复合类名串 */\nfunction toList(value: string | string[]): string[] {\n  return (Array.isArray(value) ? value : [value])\n    .flatMap((item) => item.split(/\\s+/))\n    .filter((item) => item.length > 0)\n}\n\nconst defaultClassNames = {\n  loop: 'is-loop',\n  draggable: 'is-draggable',\n  dragging: 'is-dragging',\n  snapped: 'is-snapped',\n  inView: 'is-in-view',\n}\n\n/** 创建 classNames 插件 */\nexport function createClassNamesPlugin(options: XCarouselClassNamesOptions = {}) {\n  const resolved = { ...defaultClassNames, ...options }\n  const classes = {\n    loop: toList(resolved.loop),\n    draggable: toList(resolved.draggable),\n    dragging: toList(resolved.dragging),\n    snapped: toList(resolved.snapped),\n    inView: toList(resolved.inView),\n  }\n\n  let api: XCarouselClassNamesApi | undefined\n  let root: HTMLElement | undefined\n  let slides: HTMLElement[] = []\n  /* 已标记的滑动项索引，用于增量更新 */\n  let snappedIndexes: number[] = []\n  let inViewIndexes: number[] = []\n\n  function add(names: string[], elements: (HTMLElement | undefined)[]) {\n    elements.forEach((el) => el?.classList.add(...names))\n  }\n\n  function remove(names: string[], elements: (HTMLElement | undefined)[]) {\n    elements.forEach((el) => el?.classList.remove(...names))\n  }\n\n  /** 按新的索引集合更新一组类名：移除不再命中的元素，添加新命中的元素 */\n  function toggle(names: string[], previous: number[], next: number[]) {\n    remove(names, previous.filter((index) => !next.includes(index)).map((index) => slides[index]))\n    add(names, next.filter((index) => !previous.includes(index)).map((index) => slides[index]))\n  }\n\n  /** 当前吸附的滑动项：同一吸附位置可能对应多个滑动项（循环与重复项） */\n  function updateSnapped() {\n    const indexes = api?.internalEngine().slideRegistry[api.selectedScrollSnap()] ?? []\n    toggle(classes.snapped, snappedIndexes, indexes)\n    snappedIndexes = indexes\n  }\n\n  function updateInView() {\n    const indexes = api?.slidesInView() ?? []\n    toggle(classes.inView, inViewIndexes, indexes)\n    inViewIndexes = indexes\n  }\n\n  function onPointerDown() {\n    add(classes.dragging, [root])\n  }\n\n  function onPointerUp() {\n    remove(classes.dragging, [root])\n  }\n\n  function init(instance: XCarouselClassNamesApi) {\n    api = instance\n    root = instance.rootNode()\n    slides = instance.slideNodes()\n\n    const { loop, watchDrag } = instance.internalEngine().options\n    if (loop) add(classes.loop, [root])\n    if (watchDrag !== false) add(classes.draggable, [root])\n\n    if (classes.snapped.length > 0) {\n      api.on('select', updateSnapped)\n      updateSnapped()\n    }\n    if (classes.inView.length > 0) {\n      api.on('slidesInView', updateInView)\n      updateInView()\n    }\n    if (classes.dragging.length > 0) {\n      api.on('pointerDown', onPointerDown)\n      api.on('pointerUp', onPointerUp)\n    }\n  }\n\n  function destroy() {\n    if (!api) return\n    api.off('select', updateSnapped)\n    api.off('slidesInView', updateInView)\n    api.off('pointerDown', onPointerDown)\n    api.off('pointerUp', onPointerUp)\n    remove(classes.loop, [root])\n    remove(classes.draggable, [root])\n    remove(classes.dragging, [root])\n    toggle(classes.snapped, snappedIndexes, [])\n    toggle(classes.inView, inViewIndexes, [])\n    snappedIndexes = []\n    inViewIndexes = []\n    api = undefined\n  }\n\n  return {\n    name: 'classNames',\n    options: resolved,\n    init,\n    destroy,\n  }\n}\n",
      "path": "kit/class-names-plugin.ts"
    },
    {
      "type": "registry:component",
      "content": "/**\n * useXCarousel：创建与 api 绑定的轮播。\n * 用法：const [Carousel, carouselApi] = useXCarousel({ items: [...] })\n */\nimport { defineComponent, h, ref } from 'vue'\nimport type { CarouselDataItem } from './XCarousel.vue'\nimport XCarousel from './XCarousel.vue'\n\nexport interface XCarouselApi {\n  /** 下一张 */\n  next: () => void\n  /** 上一张 */\n  prev: () => void\n}\n\n/** XCarousel 通过 defineExpose 暴露的实例方法 */\ninterface XCarouselExposed {\n  next: () => void\n  prev: () => void\n}\n\nexport function useXCarousel(options: {\n  items?: CarouselDataItem[]\n  autoplay?: boolean\n  interval?: number\n  loop?: boolean\n  disabled?: boolean\n  arrows?: boolean\n  dots?: boolean\n  orientation?: 'horizontal' | 'vertical'\n  fade?: boolean\n  autoHeight?: boolean\n  autoScroll?: boolean | { speed?: number; direction?: 'forward' | 'backward' }\n  wheelGestures?: boolean | { forceWheelAxis?: 'x' | 'y' }\n} = {}) {\n  const carouselRef = ref<XCarouselExposed>()\n\n  const Carousel = defineComponent({\n    name: 'XCarouselBound',\n    setup(_, { attrs, slots }) {\n      return () => h(XCarousel, { ...attrs, ...options, ref: carouselRef } as never, slots as never)\n    },\n  })\n\n  const api: XCarouselApi = {\n    next: () => carouselRef.value?.next(),\n    prev: () => carouselRef.value?.prev(),\n  }\n\n  return [Carousel, api] as const\n}\n",
      "path": "kit/useXCarousel.ts"
    }
  ],
