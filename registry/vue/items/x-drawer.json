{
  "name": "x-drawer",
  "type": "registry:ui",
  "title": "抽屉",
  "description": "从屏幕边缘滑出的面板。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/drawer",
    "@ui-kit/x-button"
  ],
