{
  "name": "x-form-field",
  "type": "registry:ui",
  "title": "表单字段",
  "description": "带标签、说明与错误信息的表单字段。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/label",
    "@ui-kit/x-form"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\n/**\n * XFormField 表单字段：带标签、辅助说明与错误信息的表单字段。\n * 结构与 Nuxt UI 对齐：root > wrapper（labelWrapper + description）> container（控件 + error / help）。\n * 错误信息优先取 error prop，其次按 name 或 errorPattern 匹配表单校验结果。\n * eagerValidation / validateOnInputDelay 通过 provide 供字段内的表单控件读取。\n */\nimport type { Component, HTMLAttributes } from 'vue'\nimport { computed, provide, useId, useSlots } from 'vue'\nimport { Label, Primitive } from 'reka-ui'\nimport {\n  XFormFieldContextKey,\n  injectXForm,\n  type FormFieldContext,\n} from '@/components/kit/XFormContext'\nimport { cn } from '@/lib/utils'\n\ntype FormFieldSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl'\ntype FormFieldOrientation = 'vertical' | 'horizontal'\n\n/** 主题插槽类名，键名与 Nuxt UI 主题保持一致 */\nexport interface FormFieldUi {\n  root?: string\n  wrapper?: string\n  labelWrapper?: string\n  label?: string\n  container?: string\n  description?: string\n  error?: string\n  hint?: string\n  help?: string\n}\n\n/** 尺寸 → 根节点字号（对齐 Nuxt UI form-field 主题） */\nconst sizeClasses: Record<FormFieldSize, string> = {\n  xs: 'text-xs',\n  sm: 'text-xs',\n  md: 'text-sm',\n  lg: 'text-sm',\n  xl: 'text-base',\n}\n\nconst props = withDefaults(defineProps<{\n  /** 渲染为指定元素或组件 */\n  as?: string | Component\n  /** 字段名（关联表单校验结果） */\n  name?: string\n  /** 正则匹配表单错误名，用于数组字段（如 tags.0） */\n  errorPattern?: RegExp\n  /** 标签文字 */\n  label?: string\n  /** 辅助说明 */\n  description?: string\n  /** 无错误时显示的帮助文案 */\n  help?: string\n  /** 错误信息：true 强制错误态，false 关闭错误显示 */\n  error?: boolean | string\n  /** 标签右侧的提示文案（说明填写要求） */\n  hint?: string\n  /** 尺寸（控制根节点字号） */\n  size?: FormFieldSize\n  /** 是否必填 */\n  required?: boolean\n  /** 输入时立即校验，不等待 blur */\n  eagerValidation?: boolean\n  /** 输入校验的防抖延迟（毫秒） */\n  validateOnInputDelay?: number\n  /** 排列方向 */\n  orientation?: FormFieldOrientation\n  /** 控件 id（label 关联用） */\n  id?: string\n  /** 主题插槽类名 */\n  ui?: FormFieldUi\n  class?: HTMLAttributes['class']\n}>(), {\n  error: undefined,\n  orientation: 'vertical',\n  validateOnInputDelay: 300,\n})\n\nconst form = injectXForm()\n\nconst fallbackId = useId()\nconst ariaId = computed(() => props.id ?? fallbackId)\n\n/** 字段错误：error prop 优先，其次按 name / errorPattern 匹配表单错误 */\nconst fieldError = computed(() => {\n  if (props.error !== undefined && props.error !== false) return props.error\n  if (props.name != null && form.errors[props.name]) return form.errors[props.name]\n  const pattern = props.errorPattern\n  if (pattern) {\n    const key = Object.keys(form.errors).find((name) => pattern.test(name))\n    if (key != null) return form.errors[key]\n  }\n  return undefined\n})\n\n/** 有标签或说明时 container 才参与布局（对齐 Nuxt UI 门控） */\nconst slots = useSlots()\nconst hasLabel = computed(() => !!props.label || !!slots.label)\nconst hasDescription = computed(() => !!props.description || !!slots.description)\nconst hasHint = computed(() => !!props.hint || !!slots.hint)\nconst hasHelp = computed(() => !!props.help || !!slots.help)\nconst hasMeta = computed(() => hasLabel.value || hasDescription.value)\n\nprovide(\n  XFormFieldContextKey,\n  computed<FormFieldContext>(() => ({\n    name: props.name,\n    size: props.size,\n    error: fieldError.value,\n    eagerValidation: props.eagerValidation,\n    validateOnInputDelay: props.validateOnInputDelay,\n    errorPattern: props.errorPattern,\n    hint: props.hint,\n    description: props.description,\n    help: props.help,\n    ariaId: ariaId.value,\n  })),\n)\n</script>\n\n<template>\n  <Primitive\n    :as=\"as ?? 'div'\"\n    :data-orientation=\"orientation\"\n    data-slot=\"root\"\n    :class=\"cn(\n      sizeClasses[size ?? 'md'],\n      orientation === 'horizontal' && 'flex justify-between place-items-baseline gap-2',\n      props.ui?.root,\n      props.class,\n    )\"\n  >\n    <div data-slot=\"wrapper\" :class=\"cn(props.ui?.wrapper)\">\n      <div\n        v-if=\"hasLabel\"\n        data-slot=\"labelWrapper\"\n        :class=\"cn('flex content-center items-center justify-between gap-1', props.ui?.labelWrapper)\"\n      >\n        <Label\n          :for=\"ariaId\"\n          data-slot=\"label\"\n          :class=\"cn('block font-medium text-foreground', props.ui?.label)\"\n        >\n          <slot name=\"label\" :label=\"label\">\n            {{ label }}\n          </slot>\n          <span v-if=\"required\" class=\"ml-0.5 text-error-6\">*</span>\n        </Label>\n        <span\n          v-if=\"hasHint\"\n          :id=\"`${ariaId}-hint`\"\n          data-slot=\"hint\"\n          :class=\"cn('text-muted-foreground', props.ui?.hint)\"\n        >\n          <slot name=\"hint\" :hint=\"hint\">\n            {{ hint }}\n          </slot>\n        </span>\n      </div>\n\n      <p\n        v-if=\"hasDescription\"\n        :id=\"`${ariaId}-description`\"\n        data-slot=\"description\"\n        :class=\"cn('text-muted-foreground', props.ui?.description)\"\n      >\n        <slot name=\"description\" :description=\"description\">\n          {{ description }}\n        </slot>\n      </p>\n    </div>\n\n    <div\n      :class=\"hasMeta\n        ? cn(\n            'relative',\n            orientation === 'vertical' && 'mt-1',\n            props.ui?.container,\n          )\n        : undefined\"\n    >\n      <slot :error=\"fieldError\" />\n      <div\n        v-if=\"error !== false && ((typeof fieldError === 'string' && fieldError) || !!slots.error)\"\n        :id=\"`${ariaId}-error`\"\n        role=\"alert\"\n        data-slot=\"error\"\n        :class=\"cn('mt-2 text-error-6', props.ui?.error)\"\n      >\n        <slot name=\"error\" :error=\"fieldError\">\n          {{ fieldError }}\n        </slot>\n      </div>\n      <div\n        v-else-if=\"hasHelp\"\n        :id=\"`${ariaId}-help`\"\n        data-slot=\"help\"\n        :class=\"cn('mt-2 text-muted-foreground', props.ui?.help)\"\n      >\n        <slot name=\"help\" :help=\"help\">\n          {{ help }}\n        </slot>\n      </div>\n    </div>\n  </Primitive>\n</template>\n",
      "path": "kit/XFormField.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * XForm 上下文：表单状态、校验规则类型与注入工具。\n * XForm 与 XFormField 共享本模块。\n */\nimport type { ComputedRef, InjectionKey } from 'vue'\nimport { inject } from 'vue'\n\n/** XFormField 注入给表单控件的字段配置（对应 Nuxt UI 的 useFormField） */\nexport interface FormFieldContext {\n  name?: string\n  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl'\n  error?: boolean | string\n  eagerValidation?: boolean\n  validateOnInputDelay?: number\n  errorPattern?: RegExp\n  hint?: string\n  description?: string\n  help?: string\n  ariaId: string\n}\n\nexport const XFormFieldContextKey: InjectionKey<ComputedRef<FormFieldContext>> = Symbol('x-form-field')\n\n/** 标准 schema（Standard Schema 协议）：zod v4 / valibot v1 等库的对象\n * 都带有 ~standard.validate，无需引入具体依赖 */\nexport interface StandardSchema {\n  '~standard': {\n    validate: (\n      value: unknown,\n    ) => Promise<StandardSchemaResult> | StandardSchemaResult\n  }\n}\n\nexport interface StandardSchemaResult {\n  value?: unknown\n  issues?: Array<{\n    path?: Array<string | number | symbol | { key: string | number | symbol }>\n    message: string\n  }>\n}\n\nexport interface FormError {\n  name?: string\n  message: string\n}\n\n/** 按标准 schema 校验表单状态，返回错误列表；校验通过返回空数组 */\nexport async function validateSchemaValues(\n  values: Record<string, unknown>,\n  schema: StandardSchema,\n): Promise<FormError[]> {\n  const result = await schema['~standard'].validate(values)\n  if (!result.issues) return []\n  return result.issues.map((issue) => ({\n    name:\n      issue.path\n        ?.map((item) =>\n          typeof item === 'object' && item !== null\n            ? String(item.key)\n            : String(item),\n        )\n        .join('.') || '',\n    message: issue.message,\n  }))\n}\n\nexport interface FormRule {\n  /** 必填 */\n  required?: boolean\n  /** 正则校验 */\n  pattern?: RegExp\n  /** 最小值（数值或字符串长度） */\n  min?: number\n  /** 最大值（数值或字符串长度） */\n  max?: number\n  /** 自定义校验：返回 true 通过，返回字符串为错误信息 */\n  validator?: (value: unknown) => true | string\n  /** 错误信息 */\n  message?: string\n}\n\nexport interface FormContext {\n  values: Record<string, unknown>\n  errors: Record<string, string>\n  disabled: boolean\n  setValue: (name: string, value: unknown) => void\n}\n\nexport const XFormContextKey: InjectionKey<FormContext> = Symbol('x-form')\n\n/** 在表单控件中读取/更新表单状态 */\nexport function injectXForm(): FormContext {\n  const context = inject(XFormContextKey)\n  if (!context) throw new Error('injectXForm 必须在 XForm 内部使用')\n  return context\n}\n\n/** 纯校验：按规则计算全部字段错误（XForm 组件与 useXForm hook 共用） */\nexport function validateFormValues(\n  values: Record<string, unknown>,\n  rules: Record<string, FormRule[]>,\n): Record<string, string> {\n  const errors: Record<string, string> = {}\n  for (const [name, fieldRules] of Object.entries(rules)) {\n    let message: string | null = null\n    for (const rule of fieldRules) {\n      const isEmpty = values[name] == null || values[name] === ''\n      if (rule.required && isEmpty) {\n        message = rule.message ?? '此项为必填项'\n        break\n      }\n      if (isEmpty) continue\n      if (rule.pattern && typeof values[name] === 'string' && !rule.pattern.test(values[name] as string)) {\n        message = rule.message ?? '格式不正确'\n        break\n      }\n      const size = typeof values[name] === 'number' ? values[name] : typeof values[name] === 'string' ? (values[name] as string).length : 0\n      if (rule.min != null && (size as number) < rule.min) {\n        message = rule.message ?? `不能小于 ${rule.min}`\n        break\n      }\n      if (rule.max != null && (size as number) > rule.max) {\n        message = rule.message ?? `不能大于 ${rule.max}`\n        break\n      }\n      if (rule.validator) {\n        const result = rule.validator(values[name])\n        if (result !== true) {\n          message = result\n          break\n        }\n      }\n    }\n    if (message) errors[name] = message\n  }\n  return errors\n}\n",
      "path": "kit/XFormContext.ts"
    }
  ],
