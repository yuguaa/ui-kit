{
  "name": "x-alert",
  "type": "registry:ui",
  "title": "警告提示",
  "description": "展示需要关注的信息，提供四种语义。",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/alert",
    "@ui-kit/x-button"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\n/**\n * XAlert 警告提示：展示需要关注的信息，提供四种语义。\n */\nimport type { HTMLAttributes } from 'vue'\nimport { ref } from 'vue'\nimport { CircleAlert, CircleCheck, Info, OctagonX, X } from '@lucide/vue'\nimport { Alert, AlertAction, AlertDescription, AlertTitle } from '@/components/ui/alert'\nimport XButton from '@/components/kit/XButton.vue'\nimport { cn } from '@/lib/utils'\n\ntype AlertType = 'success' | 'info' | 'warning' | 'error'\n\nconst props = withDefaults(defineProps<{\n  /** 提示类型 */\n  type?: AlertType\n  /** 提示标题 */\n  message?: string\n  /** 辅助说明文字 */\n  description?: string\n  /** 是否显示关闭按钮 */\n  closable?: boolean\n  /** 是否显示图标 */\n  showIcon?: boolean\n  class?: HTMLAttributes['class']\n}>(), {\n  type: 'info',\n  closable: false,\n  showIcon: false,\n})\n\nconst emit = defineEmits<{\n  /** 点击关闭按钮时的回调 */\n  close: [event: MouseEvent]\n}>()\n\nconst visible = ref(true)\n\nconst typeClasses: Record<AlertType, string> = {\n  success: 'border-success-3 bg-success-1 text-success-8',\n  info: 'border-info-3 bg-info-1 text-info-8',\n  warning: 'border-warning-3 bg-warning-1 text-warning-8',\n  error: 'border-error-3 bg-error-1 text-error-8',\n}\n\nconst icons: Record<AlertType, typeof CircleCheck> = {\n  success: CircleCheck,\n  info: Info,\n  warning: CircleAlert,\n  error: OctagonX,\n}\n\nfunction handleClose(event: MouseEvent) {\n  visible.value = false\n  emit('close', event)\n}\n</script>\n\n<template>\n  <Alert v-if=\"visible\" :class=\"cn('flex items-start gap-2', typeClasses[type], props.class)\">\n    <component :is=\"icons[type]\" v-if=\"showIcon\" class=\"mt-0.5 size-4 shrink-0\" />\n    <div class=\"flex min-w-0 flex-1 flex-col gap-0.5\">\n      <AlertTitle v-if=\"message != null || $slots.message\"><slot name=\"message\">{{ message }}</slot></AlertTitle>\n      <AlertDescription v-if=\"description != null || $slots.description\">\n        <slot name=\"description\">{{ description }}</slot>\n      </AlertDescription>\n    </div>\n    <AlertAction v-if=\"closable\">\n      <XButton\n        variant=\"ghost\"\n        color=\"neutral\"\n        size=\"sm\"\n        aria-label=\"关闭\"\n        class=\"h-6 w-6 shrink-0 p-0\"\n        @click=\"handleClose\"\n      >\n        <X class=\"size-3.5\" />\n      </XButton>\n    </AlertAction>\n  </Alert>\n</template>\n",
      "path": "kit/XAlert.vue"
    }
  ],
