{
  "name": "x-accordion",
  "type": "registry:ui",
  "title": "手风琴",
  "description": "可展开与折叠的内容分组。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/accordion"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\n/**\n * XAccordion 手风琴：可展开与折叠的内容分组。\n * 结构对齐 Nuxt UI：root → item → header → trigger（leading / label / trailing）→ content → body。\n */\nimport type { Component, HTMLAttributes } from 'vue'\nimport { computed } from 'vue'\nimport { ChevronDown } from '@lucide/vue'\nimport {\n  AccordionContent,\n  AccordionHeader,\n  AccordionItem,\n  AccordionRoot,\n  AccordionTrigger,\n} from 'reka-ui'\nimport XIcon from '@/components/kit/XIcon.vue'\nimport { cn } from '@/lib/utils'\n\n/** 主题插槽类名，键名与 Nuxt UI 主题保持一致 */\nexport interface AccordionUi {\n  root?: string\n  item?: string\n  header?: string\n  trigger?: string\n  content?: string\n  body?: string\n  leadingIcon?: string\n  trailingIcon?: string\n  label?: string\n}\n\n/** 单项主题插槽类名 */\nexport interface AccordionItemUi {\n  item?: string\n  header?: string\n  trigger?: string\n  leadingIcon?: string\n  label?: string\n  trailingIcon?: string\n  content?: string\n  body?: string\n}\n\n/** 手风琴项：labelKey / valueKey 决定字段来源，图标可为 XIcon 图标名或组件 */\nexport interface AccordionDataItem {\n  /** 标题文本（字段名由 labelKey 决定） */\n  label?: string\n  /** 前置图标 */\n  icon?: string | Component\n  /** 后置图标，优先于组件级 trailingIcon */\n  trailingIcon?: string | Component\n  /** 内容文本 */\n  content?: string\n  /** 唯一值（字段名由 valueKey 决定），默认取索引 */\n  value?: string\n  /** 该项是否禁用 */\n  disabled?: boolean\n  class?: HTMLAttributes['class']\n  ui?: AccordionItemUi\n  [key: string]: any\n}\n\ndefineOptions({ name: 'XAccordion', inheritAttrs: false })\n\nconst props = withDefaults(defineProps<{\n  /** 手风琴项数组 */\n  items?: AccordionDataItem[]\n  /** 是否可多开 */\n  multiple?: boolean\n  /** 是否禁用 */\n  disabled?: boolean\n  /** 展开项是否可全部收起 */\n  collapsible?: boolean\n  /** 隐藏时是否卸载内容 */\n  unmountOnHide?: boolean\n  /** 默认展开项 */\n  defaultValue?: string | string[]\n  /** 标签字段名 */\n  labelKey?: string\n  /** 值字段名 */\n  valueKey?: string\n  /** 后置图标，单项 trailingIcon 优先 */\n  trailingIcon?: string | Component\n  /** 渲染为指定元素或组件 */\n  as?: string | Component\n  /** 主题插槽类名 */\n  ui?: AccordionUi\n  class?: HTMLAttributes['class']\n}>(), {\n  items: () => [],\n  multiple: false,\n  disabled: false,\n  collapsible: true,\n  unmountOnHide: true,\n  labelKey: 'label',\n  valueKey: 'value',\n})\n\nconst model = defineModel<string | string[]>()\n\n/* 未受控时传 undefined，由 reka-ui 接管状态并应用 defaultValue */\nconst accordionValue = computed(() => model.value)\n\n/** 按字段名（支持点路径）从项中取值 */\nfunction getValue(item: AccordionDataItem, key: string): unknown {\n  let value: unknown = item\n  for (const part of key.split('.')) {\n    if (value == null) return undefined\n    value = (value as Record<string, unknown>)[part]\n  }\n  return value\n}\n\n/** 图标渲染组件：字符串走 XIcon，否则原样渲染 */\nfunction iconComponent(icon: unknown): Component {\n  if (typeof icon === 'string') return XIcon\n  return (icon as Component) ?? ChevronDown\n}\n\n/** 字符串图标传给 XIcon 的 name */\nfunction iconProps(icon: unknown): Record<string, unknown> {\n  return typeof icon === 'string' ? { name: icon as never } : {}\n}\n</script>\n\n<template>\n  <AccordionRoot\n    v-bind=\"$attrs\"\n    :as=\"as\"\n    :type=\"multiple ? 'multiple' : 'single'\"\n    :collapsible=\"collapsible\"\n    :model-value=\"accordionValue\"\n    :default-value=\"defaultValue\"\n    :disabled=\"disabled\"\n    :unmount-on-hide=\"unmountOnHide\"\n    data-slot=\"root\"\n    :class=\"cn('w-full', ui?.root, props.class)\"\n    @update:model-value=\"model = ($event ?? (multiple ? [] : '')) as string | string[]\"\n  >\n    <AccordionItem\n      v-for=\"(item, index) in items\"\n      v-slot=\"{ open }\"\n      :key=\"(getValue(item, valueKey) as string | number | undefined) ?? index\"\n      :value=\"String(getValue(item, valueKey) ?? index)\"\n      :disabled=\"item.disabled\"\n      data-slot=\"item\"\n      :class=\"cn('border-b border-border last:border-b-0', ui?.item, item.ui?.item, item.class)\"\n    >\n      <AccordionHeader as=\"div\" data-slot=\"header\" :class=\"cn('flex', ui?.header, item.ui?.header)\">\n        <AccordionTrigger\n          data-slot=\"trigger\"\n          :class=\"cn(\n            'group flex flex-1 items-center gap-1.5 rounded-md py-3.5 font-medium text-sm outline-primary-6/25 min-w-0 focus-visible:outline-3',\n            item.disabled && 'cursor-not-allowed opacity-75',\n            ui?.trigger,\n            item.ui?.trigger,\n          )\"\n        >\n          <slot name=\"leading\" :item=\"item\" :index=\"index\" :open=\"open\">\n            <component\n              v-if=\"item.icon\"\n              :is=\"iconComponent(item.icon)\"\n              v-bind=\"iconProps(item.icon)\"\n              data-slot=\"leadingIcon\"\n              :class=\"cn('size-5 shrink-0', ui?.leadingIcon, item.ui?.leadingIcon)\"\n            />\n          </slot>\n\n          <span\n            v-if=\"getValue(item, labelKey) != null || $slots.default\"\n            data-slot=\"label\"\n            :class=\"cn('text-start break-words', ui?.label, item.ui?.label)\"\n          >\n            <slot :item=\"item\" :index=\"index\" :open=\"open\">{{ getValue(item, labelKey) }}</slot>\n          </span>\n\n          <slot name=\"trailing\" :item=\"item\" :index=\"index\" :open=\"open\">\n            <component\n              :is=\"iconComponent(item.trailingIcon ?? trailingIcon)\"\n              v-bind=\"iconProps(item.trailingIcon ?? trailingIcon)\"\n              data-slot=\"trailingIcon\"\n              :class=\"cn(\n                'ms-auto size-5 shrink-0 transition-transform duration-200 ease-out group-data-[state=open]:rotate-180 motion-reduce:transition-none',\n                ui?.trailingIcon,\n                item.ui?.trailingIcon,\n              )\"\n            />\n          </slot>\n        </AccordionTrigger>\n      </AccordionHeader>\n\n      <AccordionContent\n        v-if=\"item.content != null || $slots.content || $slots.body\"\n        data-slot=\"content\"\n        :class=\"cn(\n          'focus:outline-none data-[state=open]:animate-accordion-down data-[state=closed]:animate-accordion-up data-[state=closed]:overflow-hidden',\n          ui?.content,\n          item.ui?.content,\n        )\"\n      >\n        <slot name=\"content\" :item=\"item\" :index=\"index\" :open=\"open\">\n          <div data-slot=\"body\" :class=\"cn('text-sm pb-3.5', ui?.body, item.ui?.body)\">\n            <slot name=\"body\" :item=\"item\" :index=\"index\" :open=\"open\">{{ item.content }}</slot>\n          </div>\n        </slot>\n      </AccordionContent>\n    </AccordionItem>\n  </AccordionRoot>\n</template>\n",
      "path": "kit/XAccordion.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * useXAccordion：创建与 api 绑定的手风琴。\n * 用法：const [Accordion, accordionApi] = useXAccordion({ items: [...] })\n */\nimport { defineComponent, h, reactive } from 'vue'\nimport type { AccordionDataItem } from './XAccordion.vue'\nimport XAccordion from './XAccordion.vue'\n\nexport interface XAccordionApi {\n  /** 当前展开项 */\n  value: string[]\n  /** 展开指定项 */\n  open: (index: number) => void\n  /** 折叠指定项 */\n  close: (index: number) => void\n  /** 切换指定项 */\n  toggle: (index: number) => void\n}\n\nexport function useXAccordion(options: { items?: AccordionDataItem[]; defaultValue?: string[]; multiple?: boolean; disabled?: boolean } = {}) {\n  const { defaultValue = [], ...componentProps } = options\n  const state = reactive({ value: [...defaultValue] })\n\n  const Accordion = defineComponent({\n    name: 'XAccordionBound',\n    setup(_, { attrs, slots }) {\n      return () =>\n        h(\n          XAccordion,\n          {\n            ...attrs,\n            ...componentProps,\n            /* hook 的 api 以数组管理展开项，默认多开 */\n            multiple: componentProps.multiple ?? true,\n            modelValue: state.value,\n            'onUpdate:modelValue': (value: string | string[]) => {\n              state.value = Array.isArray(value) ? value : [value]\n            },\n          } as never,\n          slots as never,\n        )\n    },\n  })\n\n  const api: XAccordionApi = {\n    get value() {\n      return state.value\n    },\n    open: (index: number) => {\n      const key = String(index)\n      if (!state.value.includes(key)) state.value = [...state.value, key]\n    },\n    close: (index: number) => {\n      state.value = state.value.filter((key) => key !== String(index))\n    },\n    toggle: (index: number) => {\n      const key = String(index)\n      if (state.value.includes(key)) state.value = state.value.filter((k) => k !== key)\n      else state.value = [...state.value, key]\n    },\n  }\n\n  return [Accordion, api] as const\n}\n",
      "path": "kit/useXAccordion.ts"
    }
  ],
