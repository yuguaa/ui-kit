{
  "name": "x-button",
  "type": "registry:ui",
  "title": "二次封装按钮",
  "description": "内置 solid/outline/soft/ghost/subtle/link 六种变体 × 七种语义色，hover/active 仅颜色过渡。",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/button",
    "@ui-kit/nuxt-base"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script lang=\"ts\">\nimport type { Ref, VNode } from 'vue'\nimport type { AppConfig } from '@/lib/nuxt/types/app-config'\nimport theme from '@/lib/nuxt/ui/button'\nimport type { UseComponentIconsProps } from '../../lib/nuxt/composables/useComponentIcons'\nimport type { LinkProps } from './XLink.vue'\nimport type { AvatarProps } from './XAvatar.vue'\nimport type { ComponentConfig } from '../../lib/nuxt/types/tv'\n\ntype Button = ComponentConfig<typeof theme, AppConfig, 'button'>\n\nexport interface ButtonProps {\n\n  label?: string\n  /**\n   * @defaultValue 'primary'\n   */\n  color?: Button['variants']['color']\n  activeColor?: Button['variants']['color']\n  /**\n   * @defaultValue 'solid'\n   */\n  variant?: Button['variants']['variant']\n  activeVariant?: Button['variants']['variant']\n  /**\n   * @defaultValue 'md'\n   */\n  size?: Button['variants']['size']\n  /** Render the button with equal padding on all sides. */\n  square?: boolean\n  /** Render the button full width. */\n  block?: boolean\n  /** Set loading state automatically based on the `@click` promise state */\n  loadingAuto?: boolean\n  loading?: any\n  type?: any\n  icon?: any\n  leading?: any\n  leadingIcon?: any\n  trailing?: any\n  trailingIcon?: any\n  loadingIcon?: any\n  avatar?: any\n  active?: any\n  activeClass?: any\n  inactiveClass?: any\n  to?: any\n  disabled?: any\n  onClick?: ((event: MouseEvent) => void) | Array<((event: MouseEvent) => void)>\n  class?: any\n  ui?: Button['slots']\n}\n\nexport interface ButtonSlots {\n  leading?(props: { ui: Button['ui'] }): VNode[]\n  default?(props: { ui: Button['ui'] }): VNode[]\n  trailing?(props: { ui: Button['ui'] }): VNode[]\n}\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, ref, inject } from 'vue'\nimport { defu } from 'defu'\nimport { useAppConfig } from '@/lib/nuxt/imports'\nimport { useComponentProps } from '../../lib/nuxt/composables/useComponentProps'\nimport { useForwardProps } from '../../lib/nuxt/composables/useForwardProps'\nimport { useComponentIcons } from '../../lib/nuxt/composables/useComponentIcons'\nimport { useFieldGroup } from '../../lib/nuxt/composables/useFieldGroup'\nimport { formLoadingInjectionKey } from '../../lib/nuxt/composables/useFormField'\nimport { omit, mergeClasses } from '../../lib/nuxt/utils'\nimport { tv } from '../../lib/nuxt/utils/tv'\nimport { pickLinkProps } from '../../lib/nuxt/utils/link'\nimport XIcon from './XIcon.vue'\nimport XAvatar from './XAvatar.vue'\nimport XLink from './XLink.vue'\nimport XLinkBase from './XLinkBase.vue'\n\nconst _props = defineProps<ButtonProps>()\nconst slots = defineSlots<ButtonSlots>()\n\nconst props = useComponentProps('button', _props)\n\nconst appConfig = useAppConfig() as Button['AppConfig']\nconst { orientation, size: buttonSize } = useFieldGroup<ButtonProps>(_props)\n\n// Memoized: `omit` iterates every forwarded key through three proxy layers\n// (useForwardProps -> reactivePick -> useComponentProps), so doing it inline in\n// the template re-paid that walk on every render.\nconst linkProps = useForwardProps(pickLinkProps(props))\nconst forwardedLinkProps = computed(() => omit(linkProps.value, ['type', 'disabled', 'onClick']))\n\nconst loadingAutoState = ref(false)\nconst formLoading = inject<Ref<boolean> | undefined>(formLoadingInjectionKey, undefined)\n\nasync function onClickWrapper(event: MouseEvent) {\n  loadingAutoState.value = true\n  const callbacks = Array.isArray(props.onClick) ? props.onClick : [props.onClick]\n  try {\n    await Promise.all(callbacks.map(fn => fn?.(event)))\n  } finally {\n    loadingAutoState.value = false\n  }\n}\n\nconst isLoading = computed(() => {\n  return props.loading || (props.loadingAuto && (loadingAutoState.value || (formLoading?.value && props.type === 'submit')))\n})\n\n// Pass only the props the composable reads: a `{ ...props }` spread would walk\n// every prop through the `useComponentProps` proxy and subscribe this computed\n// (and `ui`, which reads `isLeading`/`isTrailing`) to all of them, re-running\n// the whole tv pipeline on unrelated prop changes like `class`.\nconst { isLeading, isTrailing, leadingIconName, trailingIconName } = useComponentIcons(\n  computed(() => ({\n    icon: props.icon,\n    leading: props.leading,\n    leadingIcon: props.leadingIcon,\n    trailing: props.trailing,\n    trailingIcon: props.trailingIcon,\n    loading: isLoading.value,\n    loadingIcon: props.loadingIcon\n  }))\n)\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst ui = computed(() => tv({\n  extend: theme,\n  ...defu({\n    variants: {\n      active: {\n        true: {\n          base: mergeClasses(appConfig.ui?.button?.variants?.active?.true?.base, props.activeClass)\n        },\n        false: {\n          base: mergeClasses(appConfig.ui?.button?.variants?.active?.false?.base, props.inactiveClass)\n        }\n      }\n    }\n  }, appConfig.ui?.button || {})\n})({\n  color: props.color,\n  variant: props.variant,\n  size: buttonSize.value ?? props.size,\n  loading: isLoading.value,\n  block: props.block,\n  square: props.square || (!slots.default && !props.label),\n  leading: isLeading.value,\n  trailing: isTrailing.value,\n  fieldGroup: orientation.value\n} as any))\n</script>\n\n<template>\n  <XLink\n    v-slot=\"{ active, ...slotProps }\"\n    :type=\"props.type\"\n    :disabled=\"props.disabled || isLoading\"\n    v-bind=\"forwardedLinkProps\"\n    custom\n  >\n    <XLinkBase\n      data-slot=\"base\"\n      v-bind=\"slotProps\"\n      :class=\"ui.base({\n        class: [props.ui?.base, props.class],\n        active,\n        ...(active && props.activeVariant ? { variant: props.activeVariant } : {}),\n        ...(active && props.activeColor ? { color: props.activeColor } : {})\n      })\"\n      @click=\"onClickWrapper\"\n    >\n      <slot name=\"leading\" :ui=\"ui\">\n        <XIcon v-if=\"isLeading && leadingIconName\" :name=\"leadingIconName\" data-slot=\"leadingIcon\" :class=\"ui.leadingIcon({ class: props.ui?.leadingIcon, active })\" />\n        <XAvatar v-else-if=\"!!props.avatar\" :size=\"((props.ui?.leadingAvatarSize || ui.leadingAvatarSize()) as AvatarProps['size'])\" v-bind=\"props.avatar\" data-slot=\"leadingAvatar\" :class=\"ui.leadingAvatar({ class: props.ui?.leadingAvatar, active })\" />\n      </slot>\n\n      <slot :ui=\"ui\">\n        <span v-if=\"props.label !== undefined && props.label !== null\" data-slot=\"label\" :class=\"ui.label({ class: props.ui?.label, active })\">\n          {{ props.label }}\n        </span>\n      </slot>\n\n      <slot name=\"trailing\" :ui=\"ui\">\n        <XIcon v-if=\"isTrailing && trailingIconName\" :name=\"trailingIconName\" data-slot=\"trailingIcon\" :class=\"ui.trailingIcon({ class: props.ui?.trailingIcon, active })\" />\n      </slot>\n    </XLinkBase>\n  </XLink>\n</template>\n",
      "path": "kit/XButton.vue"
    }
  ],
