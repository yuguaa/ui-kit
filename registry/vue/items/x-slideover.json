{
  "name": "x-slideover",
  "type": "registry:ui",
  "title": "侧滑",
  "description": "从侧边滑入的浮层，常用于移动端导航。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/sheet",
    "@ui-kit/x-button",
    "@ui-kit/nuxt-base"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script lang=\"ts\">\nimport type { DialogRootProps, DialogRootEmits, DialogContentProps, DialogContentEmits } from 'reka-ui'\nimport type { VNode } from 'vue'\nimport type { AppConfig } from '@/lib/nuxt/types/app-config'\nimport theme from '@/lib/nuxt/ui/slideover'\nimport type { ButtonProps } from './XButton.vue'\nimport type { IconProps } from './XIcon.vue'\nimport type { LinkPropsKeys } from './XLink.vue'\nimport type { EmitsToProps } from '../../lib/nuxt/types/utils'\nimport type { ComponentConfig } from '../../lib/nuxt/types/tv'\n\ntype Slideover = ComponentConfig<typeof theme, AppConfig, 'slideover'>\n\nexport interface SlideoverProps {\n\n  title?: string\n  description?: string\n  /** The content of the slideover. */\n  content?: Omit<DialogContentProps, 'as' | 'asChild' | 'forceMount'> & Partial<EmitsToProps<DialogContentEmits>>\n  /**\n   * Render an overlay behind the slideover.\n   * @defaultValue true\n   */\n  overlay?: boolean\n  /**\n   * Animate the slideover when opening or closing.\n   * @defaultValue true\n   */\n  transition?: boolean\n  /**\n   * The side of the slideover.\n   * @defaultValue 'right'\n   */\n  side?: Slideover['variants']['side']\n  /**\n   * Whether to inset the slideover from the edges.\n   * @defaultValue false\n   */\n  inset?: boolean\n  /**\n   * Render the slideover in a portal.\n   * @defaultValue true\n   */\n  portal?: boolean | string | HTMLElement\n  /**\n   * Display a close button to dismiss the slideover.\n   * `{ size: 'md', color: 'neutral', variant: 'ghost' }`{lang=\"ts-type\"}\n   * @defaultValue true\n   */\n  close?: boolean | Omit<ButtonProps, LinkPropsKeys>\n  /**\n   * The icon displayed in the close button.\n   * @defaultValue appConfig.ui.icons.close\n   * @IconifyIcon\n   */\n  closeIcon?: IconProps['name']\n  /**\n   * When `false`, the slideover will not close when clicking outside or pressing escape.\n   * @defaultValue true\n   */\n  dismissible?: boolean\n  class?: any\n  ui?: Slideover['slots']\n/** reka Dialog Root 透传成员（类型补齐，运行时经 useForwardProps 转发） */\n  open?: any\n  defaultOpen?: any\n  modal?: any\n  unmountOnHide?: any\n}\n\nexport interface SlideoverEmits {\n\n  'leave': []\n  'after:leave': []\n  'enter': []\n  'after:enter': []\n  'close:prevent': []\n}\n\nexport interface SlideoverSlots {\n  default?(props: { open: boolean }): VNode[]\n  content?(props: { close: () => void }): VNode[]\n  header?(props: { close: () => void }): VNode[]\n  title?(props?: {}): VNode[]\n  description?(props?: {}): VNode[]\n  actions?(props?: {}): VNode[]\n  close?(props: { ui: Slideover['ui'] }): VNode[]\n  body?(props: { close: () => void }): VNode[]\n  footer?(props: { close: () => void }): VNode[]\n}\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, toRef } from 'vue'\nimport { DialogRoot, DialogTrigger, DialogPortal, DialogOverlay, DialogContent, DialogTitle, DialogDescription, DialogClose, VisuallyHidden } from 'reka-ui'\nimport { useForwardProps } from '../../lib/nuxt/composables/useForwardProps'\nimport { reactivePick } from '@vueuse/core'\nimport { useAppConfig } from '@/lib/nuxt/imports'\nimport { useComponentProps } from '../../lib/nuxt/composables/useComponentProps'\nimport { FieldGroupReset } from '../../lib/nuxt/composables/useFieldGroup'\nimport { useLocale } from '../../lib/nuxt/composables/useLocale'\nimport { usePortal } from '../../lib/nuxt/composables/usePortal'\nimport { pointerDownOutside } from '../../lib/nuxt/utils/overlay'\nimport { tv } from '../../lib/nuxt/utils/tv'\nimport XButton from './XButton.vue'\n\nconst _props = withDefaults(defineProps<SlideoverProps>(), {\n  close: true,\n  portal: true,\n  overlay: true,\n  transition: true,\n  modal: true,\n  dismissible: true,\n  side: 'right'\n})\nconst emits = defineEmits<SlideoverEmits>()\nconst slots = defineSlots<SlideoverSlots>()\n\nconst props = useComponentProps('slideover', _props)\n\nconst { t } = useLocale()\nconst appConfig = useAppConfig() as Slideover['AppConfig']\n\nconst rootProps = useForwardProps(reactivePick(props, 'open', 'defaultOpen', 'modal', 'unmountOnHide'), emits)\nconst portalProps = usePortal(toRef(() => props.portal))\nconst contentProps = toRef(() => props.content)\nconst contentEvents = computed(() => {\n  if (!props.dismissible) {\n    const events = ['interactOutside', 'escapeKeyDown']\n\n    return events.reduce((acc, curr) => {\n      acc[curr] = (e: Event) => {\n        e.preventDefault()\n        emits('close:prevent')\n      }\n      return acc\n    }, {} as Record<typeof events[number], (e: Event) => void>)\n  }\n\n  return {\n    pointerDownOutside\n  }\n})\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst ui = computed(() => tv({ extend: theme, ...(appConfig.ui?.slideover || {}) })({\n  transition: props.transition,\n  side: props.side,\n  inset: props.inset\n} as any))\n</script>\n\n<!-- eslint-disable vue/no-template-shadow -->\n<template>\n  <DialogRoot v-slot=\"{ open, close }\" v-bind=\"rootProps\">\n    <DialogTrigger v-if=\"!!slots.default\" as-child :class=\"props.class\">\n      <slot :open=\"open\" />\n    </DialogTrigger>\n\n    <DialogPortal v-bind=\"portalProps\" :force-mount=\"(portalProps.disabled && props.unmountOnHide === false) || undefined\">\n      <FieldGroupReset>\n        <DialogOverlay v-if=\"props.overlay\" data-slot=\"overlay\" :class=\"ui.overlay({ class: props.ui?.overlay })\" />\n\n        <DialogContent\n          :data-side=\"props.side\"\n          data-slot=\"content\"\n          :class=\"ui.content({ class: [!slots.default && props.class, props.ui?.content] })\"\n          v-bind=\"contentProps\"\n          @enter=\"emits('enter')\"\n          @after-enter=\"emits('after:enter')\"\n          @leave=\"emits('leave')\"\n          @after-leave=\"emits('after:leave')\"\n          v-on=\"contentEvents\"\n        >\n          <VisuallyHidden v-if=\"(!props.title && !slots.title) || (!props.description && !slots.description) || !!slots.content\">\n            <DialogTitle v-if=\"!props.title && !slots.title\" />\n            <DialogTitle v-else-if=\"!!slots.content\">\n              <slot name=\"title\">\n                {{ props.title }}\n              </slot>\n            </DialogTitle>\n\n            <DialogDescription v-if=\"!props.description && !slots.description\" />\n            <DialogDescription v-else-if=\"!!slots.content\">\n              <slot name=\"description\">\n                {{ props.description }}\n              </slot>\n            </DialogDescription>\n          </VisuallyHidden>\n\n          <slot name=\"content\" :close=\"close\">\n            <div v-if=\"!!slots.header || (props.title || !!slots.title) || (props.description || !!slots.description) || (props.close || !!slots.close)\" data-slot=\"header\" :class=\"ui.header({ class: props.ui?.header })\">\n              <slot name=\"header\" :close=\"close\">\n                <div v-if=\"props.title || !!slots.title || props.description || !!slots.description\" data-slot=\"wrapper\" :class=\"ui.wrapper({ class: props.ui?.wrapper })\">\n                  <DialogTitle v-if=\"props.title || !!slots.title\" data-slot=\"title\" :class=\"ui.title({ class: props.ui?.title })\">\n                    <slot name=\"title\">\n                      {{ props.title }}\n                    </slot>\n                  </DialogTitle>\n\n                  <DialogDescription v-if=\"props.description || !!slots.description\" data-slot=\"description\" :class=\"ui.description({ class: props.ui?.description })\">\n                    <slot name=\"description\">\n                      {{ props.description }}\n                    </slot>\n                  </DialogDescription>\n                </div>\n\n                <slot name=\"actions\" />\n\n                <DialogClose v-if=\"props.close || !!slots.close\" as-child>\n                  <slot name=\"close\" :ui=\"ui\">\n                    <XButton\n                      v-if=\"props.close\"\n                      :icon=\"props.closeIcon || appConfig.ui.icons.close\"\n                      color=\"neutral\"\n                      variant=\"ghost\"\n                      :aria-label=\"t('slideover.close')\"\n                      v-bind=\"(typeof props.close === 'object' ? props.close : {})\"\n                      data-slot=\"close\"\n                      :class=\"ui.close({ class: props.ui?.close })\"\n                    />\n                  </slot>\n                </DialogClose>\n              </slot>\n            </div>\n\n            <div data-slot=\"body\" :class=\"ui.body({ class: props.ui?.body })\">\n              <slot name=\"body\" :close=\"close\" />\n            </div>\n\n            <div v-if=\"!!slots.footer\" data-slot=\"footer\" :class=\"ui.footer({ class: props.ui?.footer })\">\n              <slot name=\"footer\" :close=\"close\" />\n            </div>\n          </slot>\n        </DialogContent>\n      </FieldGroupReset>\n    </DialogPortal>\n  </DialogRoot>\n</template>\n",
      "path": "kit/XSlideover.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * useXSlideover：创建与 api 绑定的侧滑面板。\n * 用法：const [Slideover, slideoverApi] = useXSlideover({ title: '...' })\n */\nimport { defineComponent, h, reactive, ref } from 'vue'\nimport XSlideover from './XSlideover.vue'\n\n/** 可由 api 管理的侧滑面板状态 */\nexport interface XSlideoverState {\n  title?: string\n  description?: string\n  side?: 'top' | 'right' | 'bottom' | 'left'\n  inset?: boolean\n}\n\nexport interface XSlideoverApi {\n  /** 打开 */\n  open: () => void\n  /** 关闭 */\n  close: () => void\n  /** 切换开合 */\n  toggle: () => void\n  /** 更新内部状态（标题、方向、内嵌等） */\n  setState: (patch: XSlideoverState) => void\n  /** 写入共享数据，供面板内容读取 */\n  setData: <T extends object = Record<string, unknown>>(payload: T) => void\n  /** 读取共享数据 */\n  getData: <T extends object = Record<string, unknown>>() => T\n}\n\nexport function useXSlideover(options: XSlideoverState & { defaultOpen?: boolean } = {}) {\n  const state = reactive({\n    open: options.defaultOpen ?? false,\n    title: options.title,\n    description: options.description,\n    side: options.side,\n    inset: options.inset,\n  })\n\n  /** 与面板共享的数据载荷 */\n  const payload = ref<Record<string, unknown>>({})\n\n  const Slideover = defineComponent({\n    name: 'XSlideoverBound',\n    setup(_, { attrs, slots }) {\n      return () =>\n        h(\n          XSlideover,\n          {\n            ...attrs,\n            open: state.open,\n            title: state.title ?? (attrs.title as string | undefined),\n            description: state.description ?? (attrs.description as string | undefined),\n            side: state.side ?? (attrs.side as XSlideoverState['side'] | undefined),\n            inset: state.inset ?? (attrs.inset as boolean | undefined),\n            'onUpdate:open': (open: boolean) => {\n              state.open = open\n            },\n          } as never,\n          slots as never,\n        )\n    },\n  })\n\n  const api: XSlideoverApi = {\n    open: () => {\n      state.open = true\n    },\n    close: () => {\n      state.open = false\n    },\n    toggle: () => {\n      state.open = !state.open\n    },\n    setState: (patch) => Object.assign(state, patch),\n    setData: <T extends object = Record<string, unknown>>(data: T) => {\n      payload.value = data as Record<string, unknown>\n    },\n    getData: <T extends object = Record<string, unknown>>() => payload.value as T,\n  }\n\n  return [Slideover, api] as const\n}\n",
      "path": "kit/useXSlideover.ts"
    }
  ],
