{
  "name": "x-input-tags",
  "type": "registry:ui",
  "title": "标签输入",
  "description": "以标签形式输入多个值，回车添加。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/input",
    "@ui-kit/x-chip"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<script setup lang=\"ts\">\n/**\n * XInputTags 标签输入：以标签形式输入多个值，回车添加、点击关闭移除。\n * 按 Nuxt UI input-tags 结构对齐：root > item(itemText + itemDelete > itemDeleteIcon) + input + leading。\n * 容器注入 Nuxt UI 语义：variant × color、highlight、fixed；单个标签长度由 maxLength 限制。\n */\nimport type { Component, HTMLAttributes } from 'vue'\nimport { onMounted, onScopeDispose, ref, useTemplateRef } from 'vue'\nimport { X } from '@lucide/vue'\nimport { Primitive } from 'reka-ui'\nimport XIcon from '@/components/kit/XIcon.vue'\nimport { cn } from '@/lib/utils'\n\n/* 属性透传到内部 input，避免落到外层包装元素 */\ndefineOptions({ inheritAttrs: false })\n\ntype TagsSize = 'xs' | 'sm' | 'md' | 'lg' | 'xl'\ntype TagsColor = 'primary' | 'secondary' | 'neutral' | 'success' | 'info' | 'warning' | 'error'\ntype TagsVariant = 'outline' | 'soft' | 'subtle' | 'ghost' | 'none'\n\n/** XIcon 内置图标名 */\nexport type InputTagsIconName = 'x' | 'trash'\n/** 图标：XIcon 名称或自定义组件 */\nexport type InputTagsIcon = InputTagsIconName | Component\n\n/** 主题插槽类名，键名与 Nuxt UI 主题保持一致 */\nexport interface InputTagsUi {\n  root?: string\n  base?: string\n  item?: string\n  itemText?: string\n  itemDelete?: string\n  itemDeleteIcon?: string\n  input?: string\n  leading?: string\n}\n\nconst props = withDefaults(defineProps<{\n  /** 标签数组 */\n  modelValue?: string[]\n  /** 最大标签数 */\n  max?: number\n  /** 占位文字 */\n  placeholder?: string\n  /** 是否禁用 */\n  disabled?: boolean\n  /** 单个标签最大长度 */\n  maxLength?: number\n  /** 删除标签图标 */\n  deleteIcon?: InputTagsIcon\n  /** 控件尺寸 */\n  size?: TagsSize\n  /** 组件颜色（聚焦描边与高亮） */\n  color?: TagsColor\n  /** 预设样式 */\n  variant?: TagsVariant\n  /** 高亮：始终显示颜色描边，类似聚焦态 */\n  highlight?: boolean\n  /** 保持移动端字号在所有断点一致 */\n  fixed?: boolean\n  /** 渲染为指定元素或组件 */\n  as?: string | Component\n  /** 挂载后自动聚焦 */\n  autofocus?: boolean\n  /** 自动聚焦延迟（毫秒） */\n  autofocusDelay?: number\n  /** 主题插槽类名 */\n  ui?: InputTagsUi\n  class?: HTMLAttributes['class']\n}>(), {\n  modelValue: () => [],\n  placeholder: '输入后回车添加…',\n  deleteIcon: 'x',\n  size: 'md',\n  color: 'primary',\n  variant: 'outline',\n  fixed: true,\n  autofocusDelay: 0,\n})\n\nconst emit = defineEmits<{\n  'update:modelValue': [value: string[]]\n  /** 添加标签 */\n  add: [tag: string]\n  /** 删除标签 */\n  remove: [index: number]\n}>()\n\n/** 变体样式（Nuxt UI 语义 → 本地 token） */\nconst variantClasses: Record<TagsVariant, string> = {\n  outline: 'bg-background ring-1 ring-inset ring-border',\n  soft: 'bg-muted/50 hover:bg-muted has-focus-visible:bg-muted disabled:bg-muted/50',\n  subtle: 'bg-muted ring-1 ring-inset ring-border',\n  ghost: 'bg-transparent hover:bg-muted has-focus-visible:bg-muted disabled:bg-transparent',\n  none: 'bg-transparent has-focus-visible:outline-none',\n}\n\n/** 聚焦描边（颜色 × 变体）：容器内部输入聚焦时叠加 outline 与 ring */\nconst focusStyles: Record<TagsColor, Record<TagsVariant, string>> = {\n  primary: {\n    outline: 'outline-primary-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-primary-6',\n    soft: 'outline-primary-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-primary-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-primary-6',\n    ghost: 'outline-primary-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  secondary: {\n    outline: 'outline-secondary/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-secondary',\n    soft: 'outline-secondary/25 has-focus-visible:outline-3',\n    subtle: 'outline-secondary/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-secondary',\n    ghost: 'outline-secondary/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  neutral: {\n    outline: 'outline-neutral-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-neutral-6',\n    soft: 'outline-neutral-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-neutral-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-neutral-6',\n    ghost: 'outline-neutral-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  success: {\n    outline: 'outline-success-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-success-6',\n    soft: 'outline-success-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-success-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-success-6',\n    ghost: 'outline-success-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  info: {\n    outline: 'outline-info-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-info-6',\n    soft: 'outline-info-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-info-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-info-6',\n    ghost: 'outline-info-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  warning: {\n    outline: 'outline-warning-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-warning-6',\n    soft: 'outline-warning-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-warning-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-warning-6',\n    ghost: 'outline-warning-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n  error: {\n    outline: 'outline-error-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-error-6',\n    soft: 'outline-error-6/25 has-focus-visible:outline-3',\n    subtle: 'outline-error-6/25 has-focus-visible:outline-3 has-focus-visible:ring-1 has-focus-visible:ring-error-6',\n    ghost: 'outline-error-6/25 has-focus-visible:outline-3',\n    none: '',\n  },\n}\n\n/** 高亮描边色 */\nconst highlightClasses: Record<TagsColor, string> = {\n  primary: 'ring-1 ring-inset ring-primary-6',\n  secondary: 'ring-1 ring-inset ring-secondary',\n  neutral: 'ring-1 ring-inset ring-neutral-6',\n  success: 'ring-1 ring-inset ring-success-6',\n  info: 'ring-1 ring-inset ring-info-6',\n  warning: 'ring-1 ring-inset ring-warning-6',\n  error: 'ring-1 ring-inset ring-error-6',\n}\n\n/** fixed=false 时桌面端缩小一档字号 */\nconst fixedTextClasses: Partial<Record<TagsSize, string>> = {\n  xs: 'md:text-xs',\n  sm: 'md:text-xs',\n  md: 'md:text-sm',\n  lg: 'md:text-sm',\n}\n\n/** 标签文字尺寸 */\nconst itemSizeClasses: Record<TagsSize, string> = {\n  xs: 'text-[10px]/3',\n  sm: 'text-[10px]/3',\n  md: 'text-xs',\n  lg: 'text-xs',\n  xl: 'text-sm',\n}\n\n/** 删除图标尺寸 */\nconst deleteIconSizeClasses: Record<TagsSize, string> = {\n  xs: 'size-3',\n  sm: 'size-3',\n  md: 'size-3.5',\n  lg: 'size-3.5',\n  xl: 'size-4',\n}\n\nconst draft = ref('')\n\nfunction isIconName(icon: InputTagsIcon): icon is InputTagsIconName {\n  return typeof icon === 'string'\n}\n\nfunction addTag(raw: string) {\n  const tag = raw.trim()\n  if (!tag || props.modelValue.includes(tag)) return\n  if (props.max != null && props.modelValue.length >= props.max) return\n  emit('update:modelValue', [...props.modelValue, tag])\n  emit('add', tag)\n  draft.value = ''\n}\n\nfunction removeTag(index: number) {\n  emit('update:modelValue', props.modelValue.filter((_, i) => i !== index))\n  emit('remove', index)\n}\n\n/** maxLength 限制单个标签长度 */\nfunction onDraft(value: string) {\n  draft.value = props.maxLength != null ? value.slice(0, props.maxLength) : value\n}\n\nconst inputRef = useTemplateRef<HTMLInputElement>('inputRef')\n\nfunction autoFocus() {\n  if (props.autofocus) {\n    inputRef.value?.focus()\n  }\n}\n\nlet autofocusTimeoutId: ReturnType<typeof setTimeout> | undefined\n\nonMounted(() => {\n  autofocusTimeoutId = setTimeout(() => {\n    autoFocus()\n  }, props.autofocusDelay)\n})\n\nonScopeDispose(() => clearTimeout(autofocusTimeoutId))\n</script>\n\n<template>\n  <Primitive\n    :as=\"as ?? 'span'\"\n    data-slot=\"root\"\n    :class=\"cn(\n      'relative inline-flex w-full flex-wrap items-center gap-1.5 rounded-md px-2 py-1.5 transition-colors',\n      variantClasses[variant],\n      focusStyles[color][variant],\n      highlight && highlightClasses[color],\n      fixed === false && fixedTextClasses[size],\n      disabled && 'pointer-events-none opacity-50',\n      props.ui?.base,\n      props.ui?.root,\n      props.class,\n    )\"\n  >\n    <template v-for=\"(tag, index) in modelValue\" :key=\"`${tag}-${index}`\">\n      <slot name=\"tag\" :tag=\"tag\" :index=\"index\">\n        <span\n          data-slot=\"item\"\n          :class=\"cn(\n            'inline-flex items-center gap-0.5 rounded-xs px-1.5 py-0.5 font-medium ring-1 ring-inset ring-border bg-muted text-foreground',\n            itemSizeClasses[size],\n            props.ui?.item,\n          )\"\n        >\n          <span data-slot=\"itemText\" :class=\"cn(props.ui?.itemText)\">{{ tag }}</span>\n          <button\n            type=\"button\"\n            data-slot=\"itemDelete\"\n            aria-label=\"close\"\n            :disabled=\"disabled\"\n            :class=\"cn(\n              'inline-flex items-center rounded-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground disabled:pointer-events-none',\n              props.ui?.itemDelete,\n            )\"\n            @click=\"removeTag(index)\"\n          >\n            <XIcon\n              v-if=\"isIconName(deleteIcon)\"\n              :name=\"deleteIcon\"\n              data-slot=\"itemDeleteIcon\"\n              :class=\"cn('shrink-0', deleteIconSizeClasses[size], props.ui?.itemDeleteIcon)\"\n            />\n            <component\n              :is=\"deleteIcon ?? X\"\n              v-else\n              data-slot=\"itemDeleteIcon\"\n              :class=\"cn('shrink-0', deleteIconSizeClasses[size], props.ui?.itemDeleteIcon)\"\n            />\n          </button>\n        </span>\n      </slot>\n    </template>\n    <span v-if=\"$slots.leading\" data-slot=\"leading\" :class=\"cn('inline-flex items-center', props.ui?.leading)\">\n      <slot name=\"leading\" />\n    </span>\n    <input\n      ref=\"inputRef\"\n      v-bind=\"$attrs\"\n      type=\"text\"\n      :value=\"draft\"\n      :disabled=\"disabled || (max != null && modelValue.length >= max)\"\n      :placeholder=\"modelValue.length === 0 ? placeholder : ''\"\n      :maxlength=\"maxLength\"\n      data-slot=\"input\"\n      :class=\"cn(\n        'h-6 min-w-24 flex-1 bg-transparent p-0 text-sm outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-75',\n        props.ui?.input,\n      )\"\n      @input=\"onDraft(($event.target as HTMLInputElement).value)\"\n      @keydown.enter.prevent=\"addTag(draft)\"\n      @keydown.backspace=\"!draft && modelValue.length > 0 && removeTag(modelValue.length - 1)\"\n      @blur=\"addTag(draft)\"\n    />\n  </Primitive>\n</template>\n",
      "path": "kit/XInputTags.vue"
    }
  ],
