  "files": [
    {
      "type": "registry:component",
      "content": "<script lang=\"ts\">\nimport type { VNode } from 'vue'\nimport type { AppConfig } from '@/lib/nuxt/types/app-config'\nimport type { TagsInputRootProps, TagsInputRootEmits, AcceptableInputValue } from 'reka-ui'\nimport theme from '@/lib/nuxt/ui/input-tags'\nimport type { UseComponentIconsProps } from '../../lib/nuxt/composables/useComponentIcons'\nimport type { AvatarProps } from './XAvatar.vue'\nimport type { IconProps } from './XIcon.vue'\nimport type { InputHTMLAttributes } from '../../lib/nuxt/types/html'\nimport type { ComponentConfig } from '../../lib/nuxt/types/tv'\n\ntype InputTags = ComponentConfig<typeof theme, AppConfig, 'inputTags'>\n\nexport type InputTagItem = AcceptableInputValue\n\nexport interface InputTagsProps<T extends InputTagItem = InputTagItem> {\n  style?: any;\n  id?: any;\n  title?: any;\n  role?: any;\n  value?: any;\n  readonly?: any;\n  autocomplete?: any;\n  tabindex?: any;\n  form?: any;\n  multiple?: any;\n  checked?: any;\n  rows?: any;\n  cols?: any;\n  wrap?: any;\n  accept?: any;\n  capture?: any;\n  download?: any;\n  href?: any;\n  target?: any;\n  rel?: any;\n  loading?: any;\n  accesskey?: any;\n  contenteditable?: any;\n  draggable?: any;\n  hidden?: any;\n  lang?: any;\n  slot?: any;\n  autocapitalize?: any;\n  autocorrect?: any;\n  spellcheck?: any;\n  enterkeyhint?: any;\n  inputmode?: any;\n  'aria-label'?: any;\n  'aria-describedby'?: any;\n  'aria-hidden'?: any;\n  'aria-expanded'?: any;\n  'aria-current'?: any;\n  'aria-checked'?: any;\n  'aria-controls'?: any;\n  'aria-disabled'?: any;\n  'aria-invalid'?: any;\n  'aria-live'?: any;\n  'aria-selected'?: any;\n  'data-testid'?: any;\n  /**\n   * The element or component this component should render as.\n   * @defaultValue 'div'\n   */\n  as?: any\n  /** The placeholder text when the input is empty. */\n  placeholder?: string\n  /** The maximum number of character allowed. */\n  maxLength?: number\n  /**\n   * @defaultValue 'primary'\n   */\n  color?: InputTags['variants']['color']\n  /**\n   * @defaultValue 'outline'\n   */\n  variant?: InputTags['variants']['variant']\n  /**\n   * @defaultValue 'md'\n   */\n  size?: InputTags['variants']['size']\n  autofocus?: boolean\n  autofocusDelay?: number\n  /**\n   * The icon displayed to delete a tag.\n   * @defaultValue appConfig.ui.icons.close\n   * @IconifyIcon\n   */\n  deleteIcon?: IconProps['name']\n  /** Highlight the ring color like a focus state. */\n  highlight?: boolean\n  /** Keep the mobile text size on all breakpoints. */\n  fixed?: boolean\n  /** 表单与 reka 透传成员（disabled/modelValue/defaultValue/avatar 等，运行时经 useForwardProps 转发） */\n  disabled?: any\n  modelValue?: T[]\n  defaultValue?: T[]\n  avatar?: AvatarProps\n  addOnPaste?: boolean\n  addOnTab?: boolean\n  addOnBlur?: boolean\n  duplicate?: boolean\n  delimiter?: any\n  max?: any\n  convertValue?: any\n  displayValue?: any\n  required?: boolean\n  class?: any\n  ui?: InputTags['slots']\n}\n\nexport interface InputTagsEmits<T extends InputTagItem> {\n\n  change: [event: Event]\n  blur: [event: FocusEvent]\n  focus: [event: FocusEvent]\n}\n\ntype SlotProps<T extends InputTagItem> = (props: { item: T, index: number, ui: InputTags['ui'] }) => VNode[]\n\nexport interface InputTagsSlots<T extends InputTagItem = InputTagItem> {\n  'leading'?(props: { ui: InputTags['ui'] }): VNode[]\n  'default'?(props: { ui: InputTags['ui'] }): VNode[]\n  'trailing'?(props: { ui: InputTags['ui'] }): VNode[]\n  'item-text'?: SlotProps<T>\n  'item-delete'?: SlotProps<T>\n}\n</script>\n\n<script setup lang=\"ts\" generic=\"T extends InputTagItem\">\nimport { computed, useTemplateRef, onMounted, onScopeDispose, toRaw, toRef } from 'vue'\nimport { TagsInputRoot, TagsInputItem, TagsInputItemText, TagsInputItemDelete, TagsInputInput } from 'reka-ui'\nimport { useForwardProps } from '../../lib/nuxt/composables/useForwardProps'\nimport { reactivePick } from '@vueuse/core'\nimport { useAppConfig } from '@/lib/nuxt/imports'\nimport { useComponentProps } from '../../lib/nuxt/composables/useComponentProps'\nimport { useFieldGroup } from '../../lib/nuxt/composables/useFieldGroup'\nimport { useComponentIcons } from '../../lib/nuxt/composables/useComponentIcons'\nimport { useFormField } from '../../lib/nuxt/composables/useFormField'\nimport { tv } from '../../lib/nuxt/utils/tv'\nimport XIcon from './XIcon.vue'\nimport XAvatar from './XAvatar.vue'\n\ndefineOptions({ inheritAttrs: false })\n\nconst _props = withDefaults(defineProps<InputTagsProps<T>>(), {\n  type: 'text',\n  autofocusDelay: 0\n})\nconst emits = defineEmits<InputTagsEmits<T>>()\nconst slots = defineSlots<InputTagsSlots<T>>()\n\nconst props = useComponentProps<InputTagsProps<T>>('inputTags', _props)\n\nconst appConfig = useAppConfig() as InputTags['AppConfig']\n\nconst rootProps = useForwardProps(reactivePick(props, 'as', 'addOnPaste', 'addOnTab', 'addOnBlur', 'duplicate', 'delimiter', 'max', 'convertValue', 'displayValue', 'required'), emits)\n\nconst { emitFormBlur, emitFormFocus, emitFormChange, emitFormInput, size: formFieldSize, color: formFieldColor, id, name, highlight: formFieldHighlight, disabled: formFieldDisabled, ariaAttrs } = useFormField<InputTagsProps>(_props)\n\nconst { orientation, size: fieldGroupSize } = useFieldGroup<InputTagsProps>(_props)\nconst { isLeading, isTrailing, leadingIconName, trailingIconName } = useComponentIcons(props)\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst color = computed(() => formFieldColor.value ?? props.color)\n// eslint-disable-next-line vue/no-dupe-keys\nconst highlight = computed(() => formFieldHighlight.value ?? props.highlight)\n// eslint-disable-next-line vue/no-dupe-keys\nconst size = computed(() => fieldGroupSize.value ?? formFieldSize.value ?? props.size)\n\nconst disabled = computed(() => formFieldDisabled.value ?? props.disabled)\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst ui = computed(() => tv({ extend: theme, ...(appConfig.ui?.inputTags || {}) })({\n  color: color.value,\n  variant: props.variant,\n  size: size.value,\n  loading: props.loading,\n  highlight: highlight.value,\n  fixed: props.fixed,\n  leading: isLeading.value || !!props.avatar || !!slots.leading,\n  trailing: isTrailing.value || !!slots.trailing,\n  fieldGroup: orientation.value\n} as any) as any)\n\nconst inputRef = useTemplateRef('inputRef')\n\nfunction autoFocus() {\n  if (props.autofocus) {\n    inputRef.value?.$el?.focus()\n  }\n}\n\nlet autofocusTimeoutId: ReturnType<typeof setTimeout> | undefined\n\nonMounted(() => {\n  autofocusTimeoutId = setTimeout(() => {\n    autoFocus()\n  }, props.autofocusDelay)\n})\n\nonScopeDispose(() => clearTimeout(autofocusTimeoutId))\n\nfunction onUpdate(value: T[]) {\n  if (toRaw(props.modelValue) === value) {\n    return\n  }\n  // @ts-expect-error - 'target' does not exist in type 'EventInit'\n  const event = new Event('change', { target: { value } })\n  emits('change', event)\n  emitFormChange()\n  emitFormInput()\n}\n\nfunction onBlur(event: FocusEvent) {\n  emits('blur', event)\n  emitFormBlur()\n}\n\nfunction onFocus(event: FocusEvent) {\n  emits('focus', event)\n  emitFormFocus()\n}\n\ndefineExpose({\n  inputRef: toRef(() => inputRef.value?.$el as HTMLInputElement)\n})\n</script>\n\n<!-- eslint-disable vue/no-template-shadow -->\n<template>\n  <TagsInputRoot\n    :id=\"id\"\n    v-slot=\"{ modelValue: tags }\"\n    :model-value=\"props.modelValue\"\n    :default-value=\"props.defaultValue\"\n    :data-slot=\"($attrs['data-slot'] as string | undefined) ?? 'root'\"\n    :class=\"ui.root({ class: [ui.base({ class: props.ui?.base }), props.ui?.root, props.class] })\"\n    v-bind=\"rootProps\"\n    :name=\"name\"\n    :disabled=\"disabled\"\n    @update:model-value=\"(onUpdate as any)\"\n  >\n    <TagsInputItem\n      v-for=\"(item, index) in tags\"\n      :key=\"index\"\n      :value=\"item\"\n      data-slot=\"item\"\n      :class=\"ui.item({ class: [props.ui?.item] })\"\n    >\n      <TagsInputItemText data-slot=\"itemText\" :class=\"ui.itemText({ class: [props.ui?.itemText] })\">\n        <slot v-if=\"!!slots['item-text']\" name=\"item-text\" :item=\"(item as T)\" :index=\"index\" :ui=\"ui\" />\n      </TagsInputItemText>\n\n      <TagsInputItemDelete\n        data-slot=\"itemDelete\"\n        :class=\"ui.itemDelete({ class: [props.ui?.itemDelete] })\"\n        :disabled=\"disabled\"\n      >\n        <slot name=\"item-delete\" :item=\"(item as T)\" :index=\"index\" :ui=\"ui\">\n          <XIcon :name=\"props.deleteIcon || appConfig.ui.icons.close\" data-slot=\"itemDeleteIcon\" :class=\"ui.itemDeleteIcon({ class: [props.ui?.itemDeleteIcon] })\" />\n        </slot>\n      </TagsInputItemDelete>\n    </TagsInputItem>\n\n    <TagsInputInput\n      ref=\"inputRef\"\n      v-bind=\"{ ...$attrs, ...ariaAttrs }\"\n      :placeholder=\"props.placeholder\"\n      :max-length=\"props.maxLength\"\n      data-slot=\"input\"\n      :class=\"ui.input({ class: props.ui?.input })\"\n      @blur=\"onBlur\"\n      @focus=\"onFocus\"\n    />\n\n    <slot :ui=\"ui\" />\n\n    <span v-if=\"isLeading || !!props.avatar || !!slots.leading\" data-slot=\"leading\" :class=\"ui.leading({ class: props.ui?.leading })\">\n      <slot name=\"leading\" :ui=\"ui\">\n        <XIcon v-if=\"isLeading && leadingIconName\" :name=\"leadingIconName\" data-slot=\"leadingIcon\" :class=\"ui.leadingIcon({ class: props.ui?.leadingIcon })\" />\n        <XAvatar v-else-if=\"!!props.avatar\" :size=\"((props.ui?.leadingAvatarSize || ui.leadingAvatarSize()) as AvatarProps['size'])\" v-bind=\"props.avatar\" data-slot=\"leadingAvatar\" :class=\"ui.leadingAvatar({ class: props.ui?.leadingAvatar })\" />\n      </slot>\n    </span>\n\n    <span v-if=\"isTrailing || !!slots.trailing\" data-slot=\"trailing\" :class=\"ui.trailing({ class: props.ui?.trailing })\">\n      <slot name=\"trailing\" :ui=\"ui\">\n        <XIcon v-if=\"trailingIconName\" :name=\"trailingIconName\" data-slot=\"trailingIcon\" :class=\"ui.trailingIcon({ class: props.ui?.trailingIcon })\" />\n      </slot>\n    </span>\n  </TagsInputRoot>\n</template>\n",
      "path": "kit/XInputTags.vue"
    }
