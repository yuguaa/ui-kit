{
  "name": "x-badge",
  "type": "registry:ui",
  "title": "徽标",
  "description": "展示数量或状态提示，支持数字、溢出与圆点模式。",
  "dependencies": [],
  "registryDependencies": [
    "@ui-kit/utils",
    "@ui-kit/badge"
