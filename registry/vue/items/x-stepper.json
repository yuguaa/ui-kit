{
  "name": "x-stepper",
  "type": "registry:ui",
  "title": "步骤条",
  "description": "引导用户按步骤完成流程，支持受控与非受控用法。",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "@ui-kit/utils"
  ],
  "files": [
    {
      "type": "registry:component",
      "content": "<!-- eslint-disable vue/block-tag-newline -->\n<script lang=\"ts\">\nimport type { StepperRootProps, StepperRootEmits } from 'reka-ui'\nimport type { VNode } from 'vue'\nimport type { AppConfig } from '@/lib/nuxt/types/app-config'\nimport theme from '@/lib/nuxt/ui/stepper'\nimport type { IconProps } from './XIcon.vue'\nimport type { DynamicSlots, GetItemKeys } from '../../lib/nuxt/types/utils'\nimport type { ComponentConfig } from '../../lib/nuxt/types/tv'\n\ntype Stepper = ComponentConfig<typeof theme, AppConfig, 'stepper'>\n\nexport interface StepperItem {\n  slot?: string\n  value?: string | number\n  title?: string\n  description?: string\n  /**\n   * @IconifyIcon\n   */\n  icon?: IconProps['name']\n  content?: string\n  disabled?: boolean\n  class?: any\n  ui?: Partial<Pick<Stepper['slots'], 'item' | 'container' | 'trigger' | 'indicator' | 'icon' | 'separator' | 'wrapper' | 'title' | 'description'>>\n  [key: string]: any\n}\n\nexport interface StepperProps<T extends StepperItem = StepperItem> {\n\n  /**\n   * The element or component this component should render as.\n   * @defaultValue 'div'\n   */\n  as?: any\n  items: T[]\n  /**\n   * @defaultValue 'md'\n   */\n  size?: Stepper['variants']['size']\n  /**\n   * @defaultValue 'primary'\n   */\n  color?: Stepper['variants']['color']\n  /**\n   * The orientation of the stepper.\n   * @defaultValue 'horizontal'\n   */\n  orientation?: Stepper['variants']['orientation']\n  /**\n   * The key used to get the value from the item.\n   * @defaultValue 'value'\n   */\n  valueKey?: GetItemKeys<T>\n  /**\n   * The value of the step that should be active when initially rendered. Use when you do not need to control the state of the steps.\n   */\n  defaultValue?: string | number\n  disabled?: boolean\n  class?: any\n  ui?: Stepper['slots']\n}\n\nexport type StepperEmits<T extends StepperItem = StepperItem> = {\n\n  next: [value: T]\n  prev: [value: T]\n}\n\ntype SlotProps<T extends StepperItem> = (props: { item: T }) => VNode[]\n\nexport type StepperSlots<T extends StepperItem = StepperItem> = {\n  indicator?(props: { item: T, ui: Stepper['ui'] }): VNode[]\n  wrapper?: SlotProps<T>\n  title?: SlotProps<T>\n  description?: SlotProps<T>\n  content?: SlotProps<T>\n} & DynamicSlots<T, 'wrapper' | 'title' | 'description', { item: T }>\n\n</script>\n\n<script setup lang=\"ts\" generic=\"T extends StepperItem\">\nimport { computed } from 'vue'\nimport { StepperRoot, StepperItem, StepperTrigger, StepperIndicator, StepperSeparator, StepperTitle, StepperDescription } from 'reka-ui'\nimport { reactivePick } from '@vueuse/core'\nimport { useAppConfig } from '@/lib/nuxt/imports'\nimport { useComponentProps } from '../../lib/nuxt/composables/useComponentProps'\nimport { useForwardProps } from '../../lib/nuxt/composables/useForwardProps'\nimport { tv } from '../../lib/nuxt/utils/tv'\nimport { get } from '../../lib/nuxt/utils'\nimport XIcon from './XIcon.vue'\n\nconst _props = withDefaults(defineProps<StepperProps<T>>(), {\n  orientation: 'horizontal',\n  linear: true,\n  valueKey: 'value'\n})\nconst emits = defineEmits<StepperEmits<T>>()\nconst slots = defineSlots<StepperSlots<T>>()\n\nconst props = useComponentProps<StepperProps<T>>('stepper', _props)\n\nconst modelValue = defineModel<string | number>()\n\nconst appConfig = useAppConfig() as Stepper['AppConfig']\n\nconst rootProps = useForwardProps(reactivePick(props, 'as', 'linear'))\n\n// eslint-disable-next-line vue/no-dupe-keys\nconst ui = computed(() => tv({ extend: theme, ...(appConfig.ui?.stepper || {}) })({\n  orientation: props.orientation,\n  size: props.size,\n  color: props.color\n}))\n\nconst currentStepIndex = computed({\n  get() {\n    const value = modelValue.value ?? props.defaultValue\n\n    return ((typeof value === 'string')\n      ? props.items.findIndex(item => get(item, props.valueKey as string) === value)\n      : value) ?? 0\n  },\n  set(value: number) {\n    modelValue.value = get(props.items?.[value], props.valueKey as string) ?? value\n  }\n})\n\nconst currentStep = computed(() => props.items?.[currentStepIndex.value])\nconst hasNext = computed(() => currentStepIndex.value < props.items?.length - 1)\nconst hasPrev = computed(() => currentStepIndex.value > 0)\n\ndefineExpose({\n  next() {\n    if (hasNext.value) {\n      currentStepIndex.value += 1\n      emits('next', currentStep.value as T)\n    }\n  },\n  prev() {\n    if (hasPrev.value) {\n      currentStepIndex.value -= 1\n      emits('prev', currentStep.value as T)\n    }\n  },\n  hasNext,\n  hasPrev\n})\n</script>\n\n<template>\n  <StepperRoot v-bind=\"rootProps\" v-model=\"currentStepIndex\" :orientation=\"props.orientation\" data-slot=\"root\" :class=\"ui.root({ class: [props.ui?.root, props.class] })\">\n    <div data-slot=\"header\" :class=\"ui.header({ class: props.ui?.header })\">\n      <StepperItem\n        v-for=\"(item, count) in props.items\"\n        :key=\"count\"\n        :step=\"count\"\n        :disabled=\"item.disabled || props.disabled\"\n        data-slot=\"item\"\n        :class=\"ui.item({ class: [props.ui?.item, item.ui?.item, item.class] })\"\n      >\n        <div data-slot=\"container\" :class=\"ui.container({ class: [props.ui?.container, item.ui?.container] })\">\n          <StepperTrigger data-slot=\"trigger\" :class=\"ui.trigger({ class: [props.ui?.trigger, item.ui?.trigger] })\">\n            <StepperIndicator data-slot=\"indicator\" :class=\"ui.indicator({ class: [props.ui?.indicator, item.ui?.indicator] })\">\n              <slot name=\"indicator\" :item=\"item\" :ui=\"ui\">\n                <XIcon v-if=\"item.icon\" :name=\"item.icon\" data-slot=\"icon\" :class=\"ui.icon({ class: [props.ui?.icon, item.ui?.icon] })\" />\n                <template v-else>\n                  {{ count + 1 }}\n                </template>\n              </slot>\n            </StepperIndicator>\n          </StepperTrigger>\n\n          <StepperSeparator\n            v-if=\"count < props.items.length - 1\"\n            data-slot=\"separator\"\n            :class=\"ui.separator({ class: [props.ui?.separator, item.ui?.separator] })\"\n          />\n        </div>\n\n        <div data-slot=\"wrapper\" :class=\"ui.wrapper({ class: [props.ui?.wrapper, item.ui?.wrapper] })\">\n          <slot :name=\"((item.slot ? `${item.slot}-wrapper` : 'wrapper') as keyof StepperSlots<T>)\" :item=\"(item as Extract<T, { slot: string; }>)\">\n            <StepperTitle v-if=\"item.title || !!slots[(item.slot ? `${item.slot}-title` : 'title') as keyof StepperSlots<T>]\" as=\"div\" data-slot=\"title\" :class=\"ui.title({ class: [props.ui?.title, item.ui?.title] })\">\n              <slot :name=\"((item.slot ? `${item.slot}-title` : 'title') as keyof StepperSlots<T>)\" :item=\"(item as Extract<T, { slot: string; }>)\">\n                {{ item.title }}\n              </slot>\n            </StepperTitle>\n            <StepperDescription v-if=\"item.description || !!slots[(item.slot ? `${item.slot}-description` : 'description') as keyof StepperSlots<T>]\" as=\"div\" data-slot=\"description\" :class=\"ui.description({ class: [props.ui?.description, item.ui?.description] })\">\n              <slot :name=\"((item.slot ? `${item.slot}-description` : 'description') as keyof StepperSlots<T>)\" :item=\"(item as Extract<T, { slot: string; }>)\">\n                {{ item.description }}\n              </slot>\n            </StepperDescription>\n          </slot>\n        </div>\n      </StepperItem>\n    </div>\n\n    <div v-if=\"currentStep?.content || !!slots.content || (currentStep?.slot && !!slots[currentStep.slot as keyof StepperSlots<T>])\" data-slot=\"content\" :class=\"ui.content({ class: props.ui?.content })\">\n      <slot\n        :name=\"((currentStep?.slot || 'content') as keyof StepperSlots<T>)\"\n        :item=\"(currentStep as Extract<T, { slot: string }>)\"\n      >\n        {{ currentStep?.content }}\n      </slot>\n    </div>\n  </StepperRoot>\n</template>\n",
      "path": "kit/XStepper.vue"
    },
    {
      "type": "registry:component",
      "content": "/**\n * useXStepper：创建与 api 绑定的步骤条。\n * 用法：const [Stepper, stepperApi] = useXStepper({ items: [...] })\n */\nimport { defineComponent, h, reactive } from 'vue'\nimport type { StepperItem } from './XStepper.vue'\nimport XStepper from './XStepper.vue'\n\nexport interface XStepperApi {\n  /** 当前步骤索引 */\n  current: number\n  /** 下一步 */\n  next: () => void\n  /** 上一步 */\n  prev: () => void\n  /** 重置到第一步 */\n  reset: () => void\n  /** 跳转到指定步骤 */\n  go: (index: number) => void\n}\n\nexport function useXStepper(options: { items?: StepperItem[]; defaultValue?: number; orientation?: 'horizontal' | 'vertical'; disabled?: boolean; linear?: boolean } = {}) {\n  const { defaultValue = 0, ...componentProps } = options\n  const state = reactive({ current: defaultValue })\n\n  const itemsCount = options.items?.length ?? 0\n\n  function go(index: number) {\n    if (index < 0 || index >= itemsCount) return\n    state.current = index\n  }\n\n  const Stepper = defineComponent({\n    name: 'XStepperBound',\n    setup(_, { attrs, slots }) {\n      return () =>\n        h(\n          XStepper,\n          {\n            ...attrs,\n            ...componentProps,\n            modelValue: state.current,\n            'onUpdate:modelValue': (value: number) => {\n              state.current = value\n            },\n          } as never,\n          slots as never,\n        )\n    },\n  })\n\n  const api: XStepperApi = {\n    get current() {\n      return state.current\n    },\n    next: () => go(state.current + 1),\n    prev: () => go(state.current - 1),\n    reset: () => go(0),\n    go,\n  }\n\n  return [Stepper, api] as const\n}\n",
      "path": "kit/useXStepper.ts"
    }
  ],
